<page-meta page-style="{{themeStyle}}"/>
<view wx:if="{{!hasProfile}}" class="card"><view class="title">请先完善身体资料</view><button bindtap="goAssess">去填写</button></view>
<block wx:else>
 <view class="page-heading">饮食<view class="page-sub">吃得清楚，练得踏实</view></view>
 <view class="date-nav"><text data-d="-1" bindtap="shiftDate">‹ 前一天</text><picker mode="date" value="{{viewDate}}" bindchange="dateChange">{{viewDate}} ▾</picker><text data-d="1" bindtap="shiftDate">后一天 ›</text></view>
 <view wx:if="{{actualLoading}}" class="card muted">正在读取饮食记录…</view>
 <view wx:elif="{{actualError}}" class="card"><view>饮食记录读取失败</view><button bindtap="loadActual">重新读取</button></view>
 <view wx:else class="card compact-diet">
 <view class="row between"><view class="title">今日饮食</view><text class="muted">{{calTarget}} kcal</text></view>
 <view class="diet-reference" bindtap="toggleReference"><view>我的饮食参考<view class="muted">查看与调整食材、份量</view></view><text>›</text></view>
 <view class="diet-energy"><view><text class="diet-number {{dietOver?'over':''}}">{{dietTotal.kcal||0}}</text> 大卡<view class="muted">{{dietOver?'已超目标':'距目标'}} {{dietRemain}} 大卡</view></view><view class="diet-ring" style="{{ringStyle}}"><view><text class="muted">目标进度</text><text>{{calorieProgress.pct||0}}%</text></view></view></view>
 <view class="diet-macros"><view wx:for="{{nutrientProgress}}" wx:key="key" class="diet-macro pb-{{item.key}} {{item.over?'over':''}}"><view class="muted">{{item.label}}</view><view>{{item.got}} / {{item.target}}g</view><view>{{item.pct}}% {{item.over?'已超目标':''}}</view><view class="pb-bar"><view class="pb-in pbin-{{item.key}} {{item.over?'over':''}}" style="width:{{item.width}}%"></view></view></view></view>
 <view class="muted diet-note">消耗 {{energy.tdee}} · 摄入 {{calTarget}} kcal · {{energy.deficit>0?'缺口':energy.deficit<0?'盈余':'持平'}} {{energy.deficit<0?-energy.deficit:energy.deficit}} kcal</view>
 <view class="diet-meals"><view wx:for="{{mealGroups}}" wx:key="k" data-k="{{item.k}}" bindtap="openFoodPanel"><view class="meal-icon">{{item.k==='b'?'☀':item.k==='l'?'◷':item.k==='d'?'☾':'＋'}}</view><view>{{item.name}}</view><view class="muted">{{item.items.length?item.sum:'去记录'}}</view></view></view>
 </view>
 <view class="card fold" data-section="adjust"><view class="fold-head" bindtap="toggleAdjust"><text>目标计算与饮食调整</text><text>{{adjustOpen?'−':'＋'}}</text></view><block wx:if="{{adjustOpen}}">
 <view class="inner-section"><view class="title">消耗与缺口 <text class="mini">{{profile.goal}}</text></view><view class="energy-grid"><view><view class="energy-value">{{energy.tdee}}</view><view class="muted">每天总消耗</view></view><view><view class="energy-value green">{{diet.kcal}}</view><view class="muted">建议每天吃</view></view><view><view class="energy-value">{{energy.deficit>0?'-':energy.deficit<0?'+':'±'}}{{energy.deficit<0?-energy.deficit:energy.deficit}}</view><view class="muted">{{energy.deficit>=0?'缺口':'盈余'}} / 天</view></view></view><view class="muted">总消耗 = 基础代谢 {{energy.bmr}} × 活动系数 {{energy.factor}}（{{energy.actName}}）。消耗是估算值，请结合实际执行和长期趋势复核。</view><view class="muted">当前偏移：饥饿反馈 碳水 {{breakdown.hunger.carb}} / 蛋白 {{breakdown.hunger.protein}} g/kg；宏观调控 {{breakdown.macro.kcal}} kcal</view></view>
 <view class="inner-section"><view class="title">宏观调控</view><view wx:if="{{trendLoading}}" class="muted">读取体重趋势…</view><button wx:elif="{{trendError}}" bindtap="loadTrend">读取失败，点此重试</button><block wx:else><view class="muted">{{review.headline||review.reason}}</view><view class="muted">{{review.message}}</view><block wx:if="{{review.trend}}"><view class="kv-line"><text>每周变化</text><text>{{review.trend.perWeek}} kg</text></view><view class="kv-line"><text>每周比例</text><text>{{trendPct}}%</text></view><view class="kv-line"><text>可信度</text><text>{{review.trend.confidence==='high'?'高':review.trend.confidence==='mid'?'中':'低'}}</text></view><view class="muted">{{review.window.from}} — {{review.window.to}} · 波动 ±{{review.window.sd}} kg</view><view class="muted">目标：{{review.target.tip}}</view></block><block wx:else><view class="muted">体重记录 {{review.progress.havePoints||0}} / {{review.progress.needPoints||4}} 次</view><view class="bar"><view class="bar-in" style="width:{{pointPct}}%"></view></view><view class="muted">跨度 {{review.progress.haveDays||0}} / {{review.progress.needDays||7}} 天</view><view class="bar"><view class="bar-in" style="width:{{dayPct}}%"></view></view></block><view wx:if="{{review.action}}"><view class="kv-line"><text>碳水</text><text>{{diet.carb}} → {{after.carb}} g</text></view><view class="kv-line"><text>热量</text><text>{{diet.kcal}} → {{after.kcal}} kcal</text></view><view class="muted">蛋白质和脂肪不变，只调整碳水热量；每次至少间隔7天。</view><button class="btn" disabled="{{adjustBusy}}" bindtap="applyMacro">应用这次调整</button></view><view wx:for="{{breakdown.macroHistory}}" wx:key="date" class="muted">{{item.date}} · {{item.reason}} · {{item.carbGrams}}g 碳水</view></block></view>
 <view class="inner-section"><view class="title">今日饥饿反馈</view><view class="chip-row"><button wx:for="{{['很饿','微饿','不饿']}}" wx:key="*this" class="chip {{hungerToday.key===item?'on':''}}" data-v="{{item}}" disabled="{{adjustBusy}}" bindtap="setHunger">{{item}}</button></view><view class="muted">同一天重新选择会替换上次反馈，不重复叠加。</view></view>
 </block></view>
 <view class="card fold" data-section="advanced"><view class="fold-head" bindtap="toggleAdvanced"><text>进阶饮食功能</text><text>{{advancedOpen?'−':'＋'}}</text></view><block wx:if="{{advancedOpen}}"><view class="title paragraph">完整版饮食 <text class="tag">{{member.valid?'已开通':'收费'}}</text></view><view class="muted">免费提供每日目标、四餐参考、饥饿反馈、体重宏观调控和食物库。完整版补充三套饮食口径、外卖点法、补剂与饮水。</view><view wx:if="{{proDiet}}" class="muted">热量 {{proDiet.kcal}} kcal · 蛋白 {{proDiet.protein}}g · 碳水 {{proDiet.base.carb}}g · 饮水 {{proDiet.water}}L</view><button class="btn ghost" bindtap="goPro">看三套口径 / 分餐 / 外卖 / 补剂</button></block></view>
</block>
