.macline { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; border-bottom: 1rpx solid var(--line); }
.macline text:first-child { width: 90rpx; color: var(--sub); font-size: 26rpx; }
.macline .strong { font-size: 34rpx; color: var(--green-dark); min-width: 140rpx; }
.macline .sub { color: var(--sub); font-size: 22rpx; }
.macline.total .strong { color: var(--text); }
.ewarn { font-size: 20rpx; color: var(--warn); background: var(--warn-soft); border-radius: 8rpx; padding: 8rpx 10rpx; margin-top: 10rpx; line-height: 1.5; }
.advice { font-size: 26rpx; color: var(--green-dark); background: var(--green-soft); border-radius: 10rpx; padding: 14rpx 16rpx; margin-top: 10rpx; line-height: 1.6; }
.dot { display: inline-block; font-size: 20rpx; padding: 4rpx 10rpx; border-radius: 999rpx; background: var(--bg); color: var(--sub); margin-right: 8rpx; }
.dot.on { background: var(--green); color: var(--button-text); }
.theory { border-top: 1rpx solid var(--line); padding: 14rpx 0; }
.theory:first-of-type { border-top: none; }
.th-t { font-weight: 600; font-size: 26rpx; }
.th-s { font-size: 24rpx; color: var(--sub); line-height: 1.6; margin-top: 4rpx; }

/* ===== 今天吃什么 ===== */
.modesw { display: flex; background: var(--bg); border-radius: 999rpx; padding: 4rpx; }
.ms { font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 999rpx; color: var(--sub); }
.ms.on { background: var(--green); color: var(--button-text); font-weight: 600; }

.meal { padding: 16rpx 0; border-top: 1rpx solid var(--line); }
.meal:first-of-type { border-top: none; }
.meal-h { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8rpx; margin-bottom: 10rpx; }
.meal-n { font-size: 28rpx; font-weight: 600; color: var(--green-dark); }
.meal-t { font-size: 22rpx; color: var(--sub); }

.dish { background: var(--bg); border-radius: 12rpx; padding: 12rpx 16rpx; margin-bottom: 8rpx; }
.dish-n { font-size: 26rpx; font-weight: 600; display: flex; justify-content: space-between; align-items: baseline; gap: 10rpx; }
.dish-k { font-size: 20rpx; color: var(--sub); font-weight: 400; }
.dish-i { font-size: 24rpx; color: var(--sub); line-height: 1.6; margin-top: 4rpx; }

.smline { display: flex; flex-wrap: wrap; gap: 12rpx; font-size: 24rpx; color: var(--green-dark); font-weight: 600; margin-bottom: 8rpx; }
.hint { font-size: 22rpx; color: var(--sub); line-height: 1.7; }

.ref-food{display:flex;align-items:center;gap:16rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line)}.ref-food>view{flex:1}.ref-food input{width:145rpx;border:1rpx solid var(--line);border-radius:12rpx;padding:14rpx;text-align:center}.muted{font-size:24rpx;line-height:1.7;margin:12rpx 0}

.compact-diet .diet-reference{display:flex;justify-content:space-between;align-items:center;background:rgba(207,151,87,.1);border:1rpx solid var(--line);border-radius:20rpx;padding:20rpx;margin:24rpx 0}.diet-energy{display:flex;align-items:center;justify-content:space-between}.diet-number{font-size:82rpx;font-weight:700}.diet-ring{width:164rpx;height:164rpx;border-radius:50%;padding:10rpx;background:var(--line)}.diet-ring>view{width:100%;height:100%;border-radius:50%;background:var(--card);display:flex;flex-direction:column;align-items:center;justify-content:center}.diet-macros{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx;margin:28rpx 0}.diet-macro{font-size:22rpx;min-width:0}.diet-macro .pb-bar{margin-top:8rpx}.diet-note{font-size:21rpx;line-height:1.7}.diet-meals{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;text-align:center;border-top:1rpx solid var(--line);padding-top:20rpx;margin-top:14rpx}.diet-meals .muted{font-size:19rpx}.meal-icon{font-size:43rpx;margin-bottom:8rpx}.diet-macro.over{color:#e05252}.diet-ring .muted{font-size:20rpx}
 .pb-bar{height:10rpx;background:var(--line);border-radius:999rpx;overflow:hidden}.pb-in{height:100%;border-radius:999rpx}.pbin-protein{background:#b279ba}.pbin-carb{background:#66a5cc}.pbin-fat{background:#d0ad59}.pb-in.over{background:var(--danger)}.date-nav{display:flex;justify-content:space-between;align-items:center;margin:0 40rpx 28rpx;font-size:24rpx;color:var(--sub)}.diet-ring{flex:none;box-sizing:border-box}.diet-number{font-size:72rpx}.diet-macro{font-size:22rpx;overflow-wrap:anywhere}.diet-macro>.muted{font-size:22rpx}.diet-reference{min-height:56rpx}.chk{display:flex;gap:12rpx}.chk button{flex:1;padding:12rpx 0;font-size:24rpx}
.fold{padding:28rpx 36rpx}.inner-section{padding:24rpx 0;border-top:1rpx solid var(--line);margin-top:20rpx}.energy-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin:24rpx 0;text-align:center}.energy-value{font-size:36rpx;font-weight:650}.energy-value.green{color:var(--green)}.energy-grid .muted{font-size:20rpx}.kv-line{display:flex;justify-content:space-between;padding:12rpx 0}.chip-row{display:flex;gap:12rpx}.chip-row button{flex:1;font-size:24rpx;padding:10rpx 0}.chip.on{background:var(--green);color:var(--button-text)}.paragraph{margin-top:24rpx}.mini{font-size:22rpx;font-weight:400;color:var(--sub)}
