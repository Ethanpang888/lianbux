.wrap { padding: 30rpx; display: flex; flex-direction: column; align-items: center; }
.pcv { width: 66vw; height: 117.3vw; border-radius: 24rpx; box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.4); }
.ops { display: flex; gap: 20rpx; margin-top: 30rpx; }
.ops .btn { width: 260rpx; }
.sharebtn { margin: 0; padding: 0; line-height: 88rpx; text-align: center; font-size: 30rpx; border-radius: 999rpx; background: transparent; color: var(--green-dark); border: 1rpx solid var(--line); }
.hint { font-size: 22rpx; margin-top: 18rpx; }
