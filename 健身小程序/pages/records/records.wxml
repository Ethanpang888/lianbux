<page-meta page-style="{{themeStyle}}"/>
  <view wx:if="{{!hasPlan}}" class="card center-empty">
    <view class="title">还没有计划</view>
    <view class="btn block" bindtap="goAssess">去测评</view>
  </view>

<block wx:else>
  <view class="card export-bar">
    <view class="row between">
      <view class="title" style="font-size:28rpx">我的记录 · {{planName}}</view>
      <view class="exp-btns">
        <view class="btn ghost sm" bindtap="copyAll">📋 复制</view>
        <view class="btn ghost sm" bindtap="exportFile">📤 导出</view>
      </view>
    </view>
    <view class="muted" style="margin-top:8rpx">可复制/导出全年训练：日期、体重、动作与每组重量次数、饮食（共 {{total}} 次打卡）。</view>
  </view>

  <view class="card">
    <view class="row between">
      <view><view style="font-size:40rpx;font-weight:800;color:var(--green)">第{{dayIndex}}天</view><view class="muted">连续打卡 {{streak}} 天</view></view>
      <view style="text-align:right"><view style="font-size:40rpx;font-weight:800">{{completion}}%</view><view class="muted">训练完成率</view></view>
    </view>
    <view class="bar"><view class="bar-in" style="width:{{completion}}%"></view></view>
  </view>

  <!-- 力量估算（网站同款：近90天最佳估算 1RM + 停滞提示） -->
  <view class="card">
    <view class="title" style="font-size:26rpx">力量估算 <text class="muted">近 90 天 · 最佳估算 1RM</text></view>
    <view wx:if="{{strength.length===0}}" class="muted" style="margin-top:8rpx;line-height:1.7">练满几次带重量的打卡后，这里会估算你的主项极限重量（1RM），并自动发现「连续做不满目标次数」的停滞动作。</view>
    <view wx:for="{{strength}}" wx:key="name" class="st-row">
      <text class="st-name">{{item.name}}</text>
      <view class="st-right">
        <text class="st-val">{{item.best}} kg</text>
        <text class="muted" style="font-size:20rpx">{{item.bestAt}} · {{item.bestRep}} 次推出</text>
        <text wx:if="{{item.stall}}" class="tag warn">连续 {{item.stall}} 次没做满 {{item.target}} 次</text>
      </view>
    </view>
    <view wx:if="{{strength.length}}" class="muted" style="margin-top:10rpx;line-height:1.6">估算口径：Epley 公式（重量 ×（1+次数/30）），由你打卡的实测推出，供参考——排计划仍以实际完成的组次为准。连续 2 次没做满目标次数 = 停滞信号，该减载或换动作了。</view>
  </view>

  <view class="card">
    <view class="title" style="font-size:26rpx">历史打卡明细</view>
    <view wx:if="{{history.length===0}}" class="muted">还没有历史打卡，去「今日」完成一次吧</view>
    <view wx:for="{{history}}" wx:key="date" class="hist">
      <view class="hist-h" bindtap="tapHistory" data-i="{{index}}">
        <text>{{item.date}} · 第{{item.dayIndex}}天</text>
        <text class="muted">{{item.trained?'训练':'休息'}} · 量{{item.volume}}kg · 食{{item.dietKcal}}kcal ›</text>
      </view>
      <view wx:if="{{expandedIdx===index}}" class="hist-b">
        <block wx:if="{{item.exercises.length}}">
          <view class="muted" style="margin-bottom:6rpx">动作记录：</view>
          <view wx:for="{{item.exercises}}" wx:for-item="ex" wx:key="name" class="hist-ex">
            <text>{{ex.name}}（{{ex.sets}}）</text>
            <text class="muted">{{ex.logStr}}</text>
          </view>
        </block>
        <view wx:if="{{item.dietStr}}" class="muted" style="margin-top:6rpx">饮食：{{item.dietStr}}</view>
        <view class="muted">喝水 {{item.waterMl}}ml · 睡眠 {{item.sleepHours}}h</view>
        <view wx:if="{{item.noteStr}}" class="muted" style="margin-top:6rpx">备注：{{item.noteStr}}</view>
      </view>
    </view>
  </view>

  <!-- 记今天体重（网站同款：整套宏观调控的「传感器」，一步可达） -->
  <view class="card">
    <view class="title" style="font-size:26rpx">今天体重 <text class="muted">早起空腹 · 同上秤</text></view>
    <view class="row" style="gap:16rpx;margin-top:16rpx">
      <input class="w-in" type="digit" placeholder="如 93.2" value="{{weightInput}}" bindinput="onWeightInput"/>
      <text class="muted">kg</text>
      <view class="btn" style="width:180rpx;padding:20rpx 0" bindtap="saveWeight">保存</view>
    </view>
    <view class="muted" style="margin-top:8rpx">每天记一次，攒够 7 天就能自动评估饮食该不该调。</view>
  </view>

  <!-- 本月打卡热力（网站同款月历） -->
  <view class="card">
    <view class="title" style="font-size:26rpx">本月打卡</view>
    <view class="heat">
      <text class="h-hdr" wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text>
      <text wx:for="{{heatCells}}" wx:key="k" class="h-cell {{item.cls}}">{{item.label}}</text>
    </view>
    <view class="muted" style="margin-top:10rpx">深色 = 完成训练打卡；浅色 = 有记录未训练</view>
  </view>

  <view class="card">
    <view class="title" style="font-size:26rpx">体重趋势</view>
    <canvas type="2d" id="wc" class="wc"></canvas>
    <view wx:if="{{weights.length===0}}" class="muted">在「今日」记录体重后这里出曲线</view>
  </view>

  <!-- 本周复盘（网站同款文案口径） -->
  <view class="card">
    <view class="title" style="font-size:26rpx">本周复盘 <text class="muted">{{weekRep.label}}</text></view>
    <view class="wk-row"><text>训练</text><text class="wk-v">{{weekRep.trained}} 天</text></view>
    <view class="wk-row"><text>体重变化</text><text class="wk-v">{{weekRep.dwStr}}</text></view>
    <view class="muted" style="margin-top:8rpx;line-height:1.6">💡 {{weekRep.trend}}</view>
  </view>

  <view class="card">
    <view class="title" style="font-size:26rpx">风险提示</view>
    <view wx:for="{{risks}}" wx:key="t" class="risk">
      <text class="rt">⚠ {{item.t}}</text>
      <text class="rd">{{item.d}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{aiEnabled}}">
    <view class="title" style="font-size:26rpx">AI 进度总结</view>
    <view wx:if="{{summary}}" class="muted" style="margin-top:10rpx;line-height:1.7">{{summary}}</view>
    <view wx:else class="muted">点下方按钮，让 AI 基于你的打卡生成一段总结与下一步建议。</view>
    <view class="btn ghost block" style="margin-top:14rpx" bindtap="aiSummary">{{aiBusy?'生成中…':'生成 AI 总结'}}</view>
  </view>

  <view class="card" wx:if="{{aiEnabled}}">
    <view class="title" style="font-size:26rpx">AI 教练对话</view>
    <view class="chat">
      <view wx:for="{{chat}}" wx:key="index" class="bubble {{item.role}}">{{item.content}}</view>
    </view>
    <view class="chat-in">
      <input value="{{input}}" bindinput="onInput" placeholder="问点什么，如：平台期怎么办？" />
      <view class="send" bindtap="sendChat">{{aiBusy?'…':'发送'}}</view>
    </view>
    <view class="muted" style="margin-top:8rpx">训练与饮食建议仅作参考，按实际状态调整。</view>
  </view>

  <view class="card" wx:else bindtap="goCoach">
    <view class="title">随身导师</view>
    <view class="muted" style="margin-top:8rpx">对训练记录有疑问？找导师聊聊 ›</view>
  </view>
</block>
