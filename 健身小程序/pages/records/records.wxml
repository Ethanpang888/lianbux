<page-meta page-style="{{themeStyle}}"/>
<view class="page-heading">修炼记录<view class="page-sub">打卡 {{total}} 天 · 本月 {{month}}</view></view>
<view wx:if="{{loading}}" class="card muted">正在读取记录…</view><view wx:elif="{{error}}" class="card"><view>{{error}}</view><button bindtap="load">重新读取</button></view>
<block wx:else>
 <view class="card" data-section="strength"><view class="title">力量估算 <text class="mini">近 90 天 · 最佳估算 1RM</text></view><view wx:if="{{!strength.length}}" class="muted paragraph">练满几次带重量的打卡后，这里会估算你的主项极限重量（1RM），并自动发现「连续做不满目标次数」的停滞动作。</view><view wx:for="{{strength}}" wx:key="name" class="history-ex"><view class="row between"><text class="strong">{{item.name}}</text><text>{{item.best}} kg</text></view><view class="muted">{{item.bestAt}} · {{item.bestRep}} 次推出</view><view wx:if="{{item.stall}}" class="tag warn">连续 {{item.stall}} 次没做满 {{item.target}} 次</view></view><button wx:if="{{hasStall}}" class="btn ghost" bindtap="goCoach">有停滞动作 → 去调一下</button><view wx:if="{{strength.length}}" class="muted paragraph">估算口径：Epley 公式（重量 ×（1+次数/30）），只计完成的工作组，供参考；排计划仍以实际完成为准。</view></view>
 <view class="card" data-section="compare"><view class="title">体型对比 <text class="mini">照片仅存本机</text></view><view wx:if="{{photos.length<2}}" class="muted paragraph">拍满两张体型照后，这里能拖动滑块前后对比。拍照在训练页练完后的「训练日志」里，照片只存在你手机本机。</view><block wx:else><view class="compare-select"><picker range="{{photoLabels}}" value="{{compareA}}" data-side="A" bindchange="compareSelect">{{photoLabels[compareA]}} ▾</picker><text class="muted">vs</text><picker range="{{photoLabels}}" value="{{compareB}}" data-side="B" bindchange="compareSelect">{{photoLabels[compareB]}} ▾</picker></view><view class="compare"><image src="{{photos[compareB].src}}" mode="aspectFit"/><image class="compare-front" style="clip-path:inset(0 {{100-comparePct}}% 0 0)" src="{{photos[compareA].src}}" mode="aspectFit"/><view class="compare-line" style="left:{{comparePct}}%"></view><text class="compare-label">{{photos[compareA].date}}</text><text class="compare-label right">{{photos[compareB].date}}</text></view><slider min="0" max="100" value="{{comparePct}}" bindchanging="compareSlide" bindchange="compareSlide" activeColor="#287b59"/><view class="muted">拖动查看前后变化；同光线、同角度拍，对比才有意义。</view></block></view>
 <view class="card" data-section="details"><view class="title">训练明细</view><view wx:if="{{!history.length}}" class="muted paragraph">训练后保存打卡，就能在这里回看重量和次数。</view><view wx:for="{{history}}" wx:key="date" class="training-history"><view class="row between" data-date="{{item.date}}" bindtap="tapHistory"><text>{{item.date}} · 已完成 {{item.done}} 组</text><text class="muted">{{expandedDate===item.date?'−':'＋'}}</text></view><block wx:if="{{expandedDate===item.date}}"><view wx:for="{{item.exercises}}" wx:for-item="ex" wx:key="name" class="history-ex"><view class="strong">{{ex.name}}</view><view class="muted">{{ex.logStr}}</view></view><button class="btn ghost" data-date="{{item.date}}" bindtap="goTraining">查看当天训练</button></block></view></view>
 <view class="card" data-section="journal"><view class="title">训练日志</view><view class="muted paragraph">{{latest?latest.text:'还没写过记录。练完在「训练」页底部写一句，或者现在就补一条今天。'}}</view><button class="btn ghost" bindtap="writeToday">写 / 改今天的记录</button></view>
 <view id="note-editor"><training-journal wx:if="{{editorDate}}" date="{{editorDate}}" history="{{timeline}}" bindsaved="noteSaved"/><button wx:if="{{editorDate}}" class="text-link" bindtap="closeEditor">收起编辑器</button></view>
 <view class="card" data-section="timeline"><view class="title">过往记录</view><view wx:if="{{!timeline.length}}" class="muted paragraph">还没有值得回顾的训练，完成训练或写一句话后就会出现在这里。</view><view wx:for="{{timeline}}" wx:key="date" class="timeline-row"><view class="row between"><text class="strong">{{item.date}}</text><text class="tag" wx:if="{{item.note.tag}}">{{item.note.tag}}</text></view><view class="muted">{{item.stats.exercises}} 个动作 · {{item.stats.sets}} 组 · {{item.stats.volume}} kg</view><view wx:if="{{item.note.subject}}" class="strong">{{item.note.subject}}</view><view class="paragraph">{{item.note.text}}</view><view wx:for="{{item.prs}}" wx:key="*this" class="muted">突破 · {{item}}</view><view class="timeline-photos"><image wx:for="{{item.note.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="preview"/></view><button class="chip" data-date="{{item.date}}" bindtap="editNote">编辑这天的记录</button></view></view>
 <view class="card" data-section="weight"><view class="title">今天体重 <text class="mini">早起空腹 · 同上秤</text></view><view class="weight-row"><input type="digit" placeholder="如 93.2" value="{{weightInput}}" bindinput="weightInput"/><text class="muted">kg</text><button class="btn" bindtap="saveWeight" disabled="{{savingWeight}}">{{savingWeight?'保存中':'保存'}}</button></view><view class="muted">{{review.ready?'已够数据评估 → 去饮食页看宏观调控建议':'每天记一次，攒够数据就能自动评估饮食该不该调。'}}</view></view>
 <view class="card" data-section="heat"><view class="title">本月打卡</view><view class="heat"><text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this" class="hdr">{{item}}</text><text wx:for="{{heatCells}}" wx:key="key" class="cell {{item.cls}}">{{item.label}}</text></view><view class="muted paragraph">深色 = 完成训练打卡；浅色 = 有记录未训练</view></view>
 <view class="card" data-section="trend"><view class="title">体重趋势 <text class="mini">{{weights.length}} 条记录</text></view><canvas wx:if="{{weights.length>=2}}" type="2d" id="weight-chart" class="weight-chart"/><view wx:if="{{!weights.length}}" class="muted paragraph">还没有体重记录</view><view wx:elif="{{weights.length===1}}" class="muted paragraph">{{weights[0].weight}} kg · 再记一次就能看到曲线</view><view wx:else class="muted">{{weights[0].weight}}kg → {{weights[weights.length-1].weight}}kg</view></view>
 <view class="card" data-section="week"><view class="title">本周复盘 <text class="mini">{{weekRep.label}}</text></view><view class="kv-line"><text class="muted">训练</text><text>{{weekRep.trained}} 天</text></view><view class="kv-line"><text class="muted">体重变化</text><text>{{weekRep.dwStr}}</text></view><view class="muted paragraph">{{weekRep.trend}}</view><view class="muted">{{weekRep.note}}</view><view wx:if="{{review.ready}}" class="muted paragraph">宏观调控：{{review.headline}}</view><button wx:if="{{review.ready}}" class="btn ghost" bindtap="goDiet">查看饮食调整</button></view>
</block>
