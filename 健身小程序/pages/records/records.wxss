.mini{font-size:22rpx;font-weight:400;color:var(--sub)}.paragraph{margin:18rpx 0;line-height:1.8}.history-ex,.training-history,.timeline-row{padding:22rpx 0;border-bottom:1rpx solid var(--line)}.history-ex:last-child,.training-history:last-child,.timeline-row:last-child{border:0}.strong{font-weight:600}.compare-select{display:flex;justify-content:space-between;gap:12rpx;margin:22rpx 0}.compare{height:500rpx;position:relative;background:var(--bg);border-radius:24rpx;overflow:hidden}.compare image{position:absolute;width:100%;height:100%}.compare-line{position:absolute;top:0;bottom:0;width:3rpx;background:var(--green)}.compare-label{position:absolute;top:14rpx;left:14rpx;background:var(--green-soft);padding:4rpx 12rpx;font-size:22rpx}.compare-label.right{left:auto;right:14rpx}.timeline-photos{display:flex;gap:12rpx;flex-wrap:wrap}.timeline-photos image{width:140rpx;height:160rpx;border-radius:18rpx}.weight-row{display:flex;align-items:center;gap:20rpx;margin:20rpx 0}.weight-row input{flex:1;min-width:0;border:2rpx solid var(--line);border-radius:20rpx;padding:22rpx;font-size:32rpx;text-align:center}.weight-row button{width:180rpx;flex-shrink:0;margin:0}.heat{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:10rpx;margin-top:24rpx;text-align:center}.heat text{height:64rpx;line-height:64rpx;border-radius:16rpx;font-size:24rpx}.heat .hdr{color:var(--sub)}.heat .hit{background:var(--green);color:var(--button-text)}.heat .part{background:var(--green-soft);color:var(--green-dark)}.weight-chart{width:100%;height:240rpx;margin-top:22rpx}.kv-line{display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid var(--line)}.chip{display:inline-flex;padding:10rpx 20rpx;background:var(--green-soft);color:var(--green-dark);font-size:24rpx;border-radius:30rpx}.text-link{background:transparent;color:var(--green-dark);font-size:24rpx}
