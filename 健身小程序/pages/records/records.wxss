.bar { height: 14rpx; background: var(--line); border-radius: 999rpx; margin-top: 16rpx; overflow: hidden; }
.bar-in { color: #12291b; height: 100%; background: var(--green); }
.export-bar .exp-btns { display: flex; gap: 12rpx; }
.export-bar .btn.sm { font-size: 24rpx; padding: 10rpx 22rpx; margin: 0; }
.export-bar .btn.ghost { background: var(--green-soft); color: var(--green-dark); border: 1rpx solid var(--line); }
.wc { width: 100%; height: 320rpx; }
.risk { padding: 14rpx 0; border-bottom: 1rpx solid var(--line); }
.risk:last-child { border-bottom: none; }
.rt { display: block; color: var(--warn); font-weight: 600; font-size: 26rpx; }
.rd { display: block; color: var(--sub); font-size: 24rpx; margin-top: 4rpx; line-height: 1.6; }
.chat { margin-top: 12rpx; max-height: 480rpx; overflow: auto; }
.bubble { max-width: 80%; padding: 16rpx 20rpx; border-radius: 16rpx; margin: 10rpx 0; font-size: 26rpx; line-height: 1.6; }
.bubble.user { background: var(--green); color: #12291b; margin-left: auto; }
.bubble.assistant { background: var(--bg); color: var(--text); }
.chat-in { display: flex; gap: 12rpx; margin-top: 12rpx; }
.chat-in input { flex: 1; background: var(--bg); border-radius: 999rpx; padding: 16rpx 24rpx; font-size: 26rpx; }
.send { background: var(--green); color: #12291b; padding: 0 30rpx; border-radius: 999rpx; display: flex; align-items: center; font-size: 26rpx; }

/* ── 对齐网站记录页新增卡片 ── */
/* 力量估算 */
.st-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.st-row:last-of-type { border-bottom: none; }
.st-name { font-size: 28rpx; font-weight: 600; color: var(--text); flex: 1; min-width: 0; }
.st-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; flex: none; }
.st-val { font-size: 30rpx; font-weight: 700; color: var(--green-dark); }
/* 记体重输入框 */
.w-in { flex: 1; border: 2rpx solid var(--line); border-radius: 16rpx; padding: 20rpx; text-align: center; background: var(--bg); color: var(--text); font-size: 30rpx; }
/* 本月热力月历 */
.heat { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 14rpx; }
.h-hdr, .h-cell { width: calc((100% - 48rpx) / 7); box-sizing: border-box; text-align: center; font-size: 22rpx; padding: 12rpx 0; border-radius: 8rpx; color: var(--sub); }
.h-cell.hit { background: var(--green); color: #12291b; font-weight: 600; }
.h-cell.part { background: var(--green-soft); color: var(--green-dark); }
.h-cell.today { border: 1rpx solid var(--line); }
.h-cell.empty { background: transparent; }
/* 本周复盘 */
.wk-row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid var(--line); font-size: 26rpx; color: var(--sub); }
.wk-row:last-of-type { border-bottom: none; }
.wk-v { color: var(--text); font-weight: 600; font-size: 28rpx; }
