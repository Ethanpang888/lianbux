<page-meta page-style="{{themeStyle}}"/>
<view wx:if="{{!loaded}}" class="card center-empty">加载中…</view>

<view wx:elif="{{!hasPlan}}" class="card center-empty">
  <view class="title">先体验，再生成个人计划</view>
  <view class="muted" style="margin:20rpx 0">免费示例可直接阅读，个人训练与记录在建档后启用。</view>
  <button class="btn ghost" data-id="bodyweight-start" bindtap="goSecret">先看居家训练示例</button>
  <button class="btn ghost" bindtap="goSecret">浏览免费秘籍</button>
  <view class="btn block" bindtap="goAssess">去测评生成计划</view>
</view>

<block wx:else>
  <view class="page-heading"><view class="page-title">训练</view><view class="muted">热身 → 力量 → 按需有氧</view></view>
  <view class="card datebar" data-section="date"><view class="row between"><text bindtap="prevDay">‹ 前一天</text><view class="strong">{{relLabel}} · {{viewDate}}</view><text bindtap="nextDay">后一天 ›</text></view><view class="muted" style="margin-top:16rpx">{{cycleLabel}}</view><view wx:if="{{!isToday}}" class="coach-link" bindtap="backToToday">回到今天</view><view class="row between" style="margin-top:18rpx"><text class="coach-link" bindtap="postponeTraining">今天没空？顺延训练</text><text class="coach-link" bindtap="goCoach">状态不好？调整训练 ›</text></view></view>
  <!-- 休息日 -->
  <view wx:if="{{isRest}}" class="card rest">
    <view style="font-size:60rpx;text-align:center;margin-bottom:10rpx">🌿</view>
    <view class="muted" style="text-align:center">{{restNote}}</view>
    <view class="btn ghost block" style="margin-top:14rpx" bindtap="skipToTrain">查看下一天训练 ▶</view>
  </view>

  <!-- 训练日 -->
  <block wx:else>
    <!-- 热身 -->
    <view wx:if="{{warmup}}" class="card warm" data-section="warmup">
      <view class="warm-h" bindtap="toggleWarmup">01 · 热身准备 · {{warmup.minutes}} 分钟 <text>{{warmupOpen?"−":"＋"}}</text></view><block wx:if="{{warmupOpen}}">
      <view wx:for="{{warmupRows}}" wx:key="*this" class="warm-check" data-i="{{index}}" bindtap="checkWarmup"><text class="done {{warmChecks[index]?'on':''}}">{{warmChecks[index]?"✓":""}}</text><view><view>{{item[0]}}</view><view class="muted">{{item[1]}}</view></view></view>
      <view wx:if="{{mainNote}}" class="warm-note">{{mainNote}}</view><button class="btn ghost" bindtap="startWarmup">开始 {{warmup.minutes}} 分钟热身计时</button><button class="btn ghost" bindtap="enterStrength">热身完成，进入力量训练</button><text class="coach-link" data-id="warmup" bindtap="goSecret">热身方法与出处 ›</text></block>
    </view>

    <view class="card" id="strength" data-section="strength"><view class="row between"><view class="title">02 · 力量训练</view><text class="tag">{{srcTag||'推演'}}</text></view><view class="strong" style="margin-top:16rpx">{{focus}}</view><view class="muted">已完成 {{progressDone}} / {{progressTotal}} 组 {{deload?'· 减载周':''}}</view><view class="bar"><view class="bar-in" style="width:{{progressPct}}%"></view></view></view>
    <!-- 正式动作 -->
    <view class="card" data-section="exercises">
      <view class="row between" style="margin-bottom:6rpx">
        <view class="title">今日训练</view>
        <view style="display:flex;gap:12rpx">
          <view class="pk-addbtn" bindtap="openPk" data-mode="add">＋ 加动作</view>
          <view class="pk-addbtn" bindtap="goPoster">📸 昭告天下</view>
        </view>
      </view>
      <view class="muted" style="margin-bottom:10rpx">训练草稿自动保存到本机 · 完成后保存云端打卡</view>
      <view class="tool-link" data-k="settingsOpen" bindtap="toggleFold">重量口径与计时设置 <text>{{settingsOpen?'−':'＋'}}</text></view><view wx:if="{{settingsOpen}}"><view class="muted">杠铃含杆、哑铃单只、自重填 0；按实际能力调整。</view><view class="row between"><text>完成一组后自动休息计时</text><switch checked="{{autoRest}}" bindchange="toggleAutoRest"/></view></view>
      <view wx:for="{{exercises}}" wx:key="name" class="ex">
        <view class="ex-h" bindtap="toggleExpand" data-i="{{index}}">
          <view class="ex-h-l">
            <text class="ex-name">{{item.name}}</text>
            <view class="ex-tags">
              <text wx:if="{{item.role}}" class="rtag r-{{item.roleKey}}">{{item.role}}</text>
              <text wx:if="{{item.homeFallback}}" class="rtag rf">居家替代</text>
            </view>
          </view>
          <view class="ex-h-r">
            <text class="sets">{{item.sets}} ›</text>
            <text class="del" data-i="{{index}}" catchtap="removeExercise">✕</text>
          </view>
        </view>
        <view wx:if="{{item.expanded}}" class="ex-b">
          <view wx:if="{{item.prescription}}" class="prescription"><view class="strong">完整版 · 今日重量 {{item.prescription.weight}} kg{{item.prescription.perSide?' / 每只':''}}</view><view class="muted">{{item.prescription.src}} · {{item.prescription.note}}</view><view wx:if="{{item.prescription.altNote}}" class="muted">{{item.prescription.altNote}}</view></view><view class="equiptag {{item.equipment==='无器械'?'home':'gym'}}">{{item.equipment==='无器械'?'🏠 居家 · 无器械':'🏋 ' + item.equipment}}</view>
          <view class="pg-box">
            <view class="pg-title" data-i="{{index}}" bindtap="toggleProgression">训练递进 · {{item.pgOn?'已启用':'可选'}} <text>{{item.pgExpanded?"−":"＋"}}</text></view><block wx:if="{{item.pgExpanded}}">
            <view wx:if="{{item.pgOn}}">
              <view class="muted">此动作按工作组推进，替代周期加重。</view>
              <view>本次目标：{{item.pgLabel||'保留原记录，下次生效'}}</view>
              <view class="row"><switch data-i="{{index}}" checked="{{item.progressReady}}" bindchange="pgToggleReady"/><text class="muted">动作稳定、没有疼痛，仍有约2次余力</text></view>
              <view class="muted">{{item.pgSource}}</view><view class="muted">{{item.pgReason}}</view>
              <view wx:if="{{item.pgSuggestion}}">下次建议：{{item.pgSuggestion}}</view>
              <button wx:if="{{item.pgCanAccept}}" size="mini" data-i="{{index}}" bindtap="pgAccept">确认采用下次目标</button>
              <button size="mini" data-i="{{index}}" bindtap="pgUndo">撤销上次采用</button>
            </view>
            <button size="mini" data-i="{{index}}" bindtap="pgEdit">{{item.pgOn?'调整 / 关闭递进':'设置递进起点'}}</button></block>
          </view>
          <view wx:if="{{item.gif}}" class="gifwrap" bindtap="fmOpen" data-i="{{index}}" data-name="{{item.name}}"><frame-gif frames="{{item.gif}}" mode="auto" equip="{{item.equipment}}" interactive="{{false}}"/><view class="gif-hint">👆 点图进入专注训练</view></view>
          <view wx:if="{{item.points}}" class="expo fm-go" bindtap="fmOpen" data-i="{{index}}" data-name="{{item.name}}">{{item.points}}<view class="fm-go-hint">点这里进入「专注训练」：大图大字带着你一组一组练</view></view>
          <view class="exops">
            <view class="exop" data-i="{{index}}" catchtap="swapEx">🔁 换动作</view>
            <view class="exop" data-i="{{index}}" catchtap="removeExercise">🗑 删除动作</view>
          </view>
          <view class="exmeta">
            <text wx:if="{{item.rest}}">组间休息 {{item.rest}}s</text>
            <text wx:if="{{item.rpe}}"> · 留约 2 次余力，动作稳定优先</text>
          </view>
          <view class="setrow setrow-h">
            <text class="setno">组</text>
            <text class="setcol">重量 (kg)</text>
            <text class="setcol">{{item.target.kind==='time'?'秒数':'次数'}}</text>
            <text class="done-h">完成</text>
          </view>
          <view wx:for="{{item.log}}" wx:for-item="s" wx:for-index="j" wx:key="j" class="setrow">
            <view class="setno">第{{j+1}}组<view wx:if="{{item.target}}"><switch data-i="{{index}}" data-j="{{j}}" checked="{{s.type==='warmup'}}" bindchange="pgToggleWarm"/><text>热身</text></view></view>
            <view class="setbox {{s.weight!==''?'fill':''}}" data-i="{{index}}" data-j="{{j}}" bindtap="openWheel">
              <text>{{s.weight!=='' ? s.weight : '参考' + item.suggest}}</text>
            </view>
            <view class="setbox {{s.reps!==''?'fill':''}}" data-i="{{index}}" data-j="{{j}}" bindtap="openWheel">
              <text>{{s.reps!=='' ? s.reps : '次数'}}</text>
            </view>
            <view class="done {{s.done?'on':''}}" data-i="{{index}}" data-j="{{j}}" bindtap="toggleSetDone">{{s.done?'✓':''}}</view>
          </view>
          <view class="setops">
            <view class="setop" data-i="{{index}}" bindtap="decSet">− 减一组</view>
            <view class="setop" data-i="{{index}}" bindtap="addSet">＋ 加一组</view>
            <view class="setop" data-i="{{index}}" bindtap="fillSets">按第一组填满</view>
          </view>
        </view>
      </view>

      <button class="btn block" bindtap="save">保存训练打卡</button><view wx:if="{{savedTip}}" class="muted" style="color:var(--green)">✓ 已保存云端</view>
      <view wx:if="{{swapMode}}" class="swapbar">
        <text class="swapbar-t">🔁 换动作模式：在下方弹层里选一个动作替换选中的动作</text>
        <view class="swapbar-cancel" bindtap="closePk">取消</view>
      </view>
    </view>

    <!-- 有氧 -->
    <view wx:if="{{cardio}}" class="card cardio" data-section="cardio">
      <view class="cd-h">03 · 有氧（选做）· {{cardio.type}}</view>
      <view class="muted" style="line-height:1.6">{{cardio.detail}}{{cardio.alt ? ' / ' + cardio.alt : ''}} · 每周 {{cardio.perWeek}}</view>
      <view class="muted" style="margin-top:6rpx;line-height:1.6">{{cardio.note}}</view><view class="row cardio-actions"><button class="btn ghost" data-seconds="900" bindtap="startCardio">轻松活动 · 15 分钟</button><button class="btn ghost" data-seconds="1200" bindtap="startCardio">走跑间歇 · 20 分钟</button></view><view class="field"><text>实际有氧类型</text><picker range="{{cardioTypes}}" range-key="name" value="{{cardioTypeIndex}}" bindchange="cardioTypeChange"><view>{{cardioTypes[cardioTypeIndex].name}} ›</view></picker></view><view class="field"><text>实际分钟数</text><input type="digit" value="{{cardioMinutes}}" placeholder="如 35（可超过推荐时长）" bindinput="cardioMinutesInput"/></view><view class="row between"><text>这是平常安排以外的额外加练</text><switch checked="{{cardioExtra}}" bindchange="cardioExtraChange"/></view><view class="muted">日常消耗已包含平常训练；额外加练才叠加估算消耗，避免重复计算。饮食目标不自动增加。</view><view wx:if="{{cardioRecord}}" class="paragraph">已记录 {{cardioRecord.name}} {{cardioRecord.minutes}} 分钟 · {{cardioRecord.kcal!==null?'估算净消耗约 '+cardioRecord.kcal+' kcal':'完善体重后可估算消耗'}}<view class="muted">{{cardioRecord.extra?'额外消耗 +'+cardioRecord.added+' kcal':'计划内活动，已包含在日常估算中'}}</view></view><button disabled="{{cardioSaving}}" loading="{{cardioSaving}}" bindtap="completeCardio">{{cardioCompleted?"更新本日有氧记录":"保存实际有氧"}}</button><button wx:if="{{cardioRecord}}" class="btn ghost" disabled="{{cardioSaving}}" bindtap="clearCardio">清除本日有氧记录</button><text class="coach-link" data-id="cardio" bindtap="goSecret">有氧方法与出处 ›</text>
    </view>
  </block>

  <view class="card" data-section="method"><view class="tool-link" data-k="methodOpen" bindtap="toggleFold"><view class="title">训练安排的依据</view><text>{{methodOpen?'−':'＋'}}</text></view><block wx:if="{{methodOpen}}"><view wx:for="{{methodRows}}" wx:key="name" style="margin-top:16rpx"><view class="strong">{{item.name}}</view><view class="muted">{{item.text}}</view></view></block></view>
  <view class="card" data-section="pro"><view class="tool-link" data-k="proOpen" bindtap="toggleFold"><view class="title">完整版 · 具体重量与周期</view><text>{{proOpen?'−':'＋'}}</text></view><view wx:if="{{proOpen}}"><view class="muted">{{member.valid?'已开通 · 还剩 '+member.days+' 天':'免费版保留动作、组次和打卡。完整版增加具体重量、周期表与完整饮食。'}}</view><button class="btn ghost" bindtap="goPro">查看完整版计划</button></view></view>
  <view class="card" data-section="coach" bindtap="goCoach"><view class="title">训练调整顾问</view><view class="muted">状态不好、错过训练、动作不合适？免费调整建议 ›</view></view>
  <view data-section="journal"><training-journal date="{{viewDate}}" history="{{journalHistory}}"/></view>
  <view class="card"><view class="tool-link" data-k="recoveryOpen" bindtap="toggleFold">补记饮水、睡眠与体重 <text>{{recoveryOpen?'−':'＋'}}</text></view><block wx:if="{{recoveryOpen}}"><view class="field"><text>饮水 ml</text><input type="digit" value="{{waterMl}}" bindinput="onWater"/></view><view class="field"><text>睡眠 小时</text><input type="digit" value="{{sleepHours}}" bindinput="onSleep"/></view><view class="field"><text>体重 kg</text><input type="digit" value="{{weight}}" bindinput="onWeight"/></view><button class="btn ghost" bindtap="save">保存补记</button></block></view>
  <!-- 重量/次数 滚轮 -->
  <view wx:if="{{showWheel}}" class="mask" bindtap="closeWheel">
    <view class="sheet" catchtap="noop">
      <view class="title" style="margin-bottom:4rpx">第{{wheelSet+1}}组 · {{wheelExName}}</view>
      <view class="muted" style="margin-bottom:10rpx">参考起步 <text style="color:var(--green);font-weight:600">{{wheelSuggest}}kg</text>（按你的体重与经验估算，按实际能力调）</view>
      <picker-view class="wheel" indicator-style="height:88rpx" value="{{wheelValue}}" bindchange="onWheelChange">
        <picker-view-column>
          <view wx:for="{{weightOptions}}" wx:key="*this" class="wheel-i">{{item===0 ? '自重' : item + ' kg'}}</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{repOptions}}" wx:key="*this" class="wheel-i">{{item}} {{wheelUnit || "次"}}</view>
        </picker-view-column>
      </picker-view>
      <view class="row" style="gap:16rpx;margin-top:20rpx">
        <view class="btn ghost" style="flex:1" bindtap="closeWheel">取消</view>
        <view class="btn" style="flex:1" bindtap="confirmWheel">确定</view>
      </view>
      <view class="collapse" bindtap="manualInput">改成手动输入 ›</view>
    </view>
  </view>

  <!-- 自定义食物表单 -->
  <view wx:if="{{showFoodForm}}" class="mask" bindtap="closeFoodForm">
    <view class="sheet" catchtap="noop">
      <view class="title" style="margin-bottom:6rpx">添加自定义食物</view>
      <view class="muted" style="margin-bottom:8rpx">若内置库没有，可手动填写每100g营养（不填则记为未识别）。</view>
      <view class="field"><text>食物名称</text><input placeholder="如：羊肉" value="{{cf.name}}" data-f="name" bindinput="cfInput"/></view>
      <view class="field"><text>吃了多少克</text><input type="digit" placeholder="默认100" value="{{cf.grams}}" data-f="grams" bindinput="cfInput"/></view>
      <view class="collapse" bindtap="toggleCfNutri">{{cf.showNutri ? '收起营养填写' : '我知道每100g营养（可选，填了才计入）'}}</view>
      <block wx:if="{{cf.showNutri}}">
        <view class="grid2">
          <view class="field sm"><text>热量kcal</text><input type="digit" placeholder="如133" value="{{cf.kcal}}" data-f="kcal" bindinput="cfInput"/></view>
          <view class="field sm"><text>蛋白g</text><input type="digit" placeholder="如24" value="{{cf.protein}}" data-f="protein" bindinput="cfInput"/></view>
          <view class="field sm"><text>碳水g</text><input type="digit" placeholder="如0" value="{{cf.carbs}}" data-f="carbs" bindinput="cfInput"/></view>
          <view class="field sm"><text>脂肪g</text><input type="digit" placeholder="如5" value="{{cf.fat}}" data-f="fat" bindinput="cfInput"/></view>
          <view class="field sm"><text>纤维g</text><input type="digit" placeholder="如0" value="{{cf.fiber}}" data-f="fiber" bindinput="cfInput"/></view>
        </view>
      </block>
      <view class="row" style="margin-top:20rpx;gap:16rpx">
        <view class="btn ghost" style="flex:1" bindtap="closeFoodForm">取消</view>
        <view class="btn" style="flex:1" bindtap="submitCustomFood">添加</view>
      </view>
    </view>
  </view>
</block>

<!-- 组间倒计时浮条（2026-10-16 与网站同步）：勾完一组自动出现 -->
<view wx:if="{{timerActive && !fm.on}}" class="rest-float">
  <view class="rf-num">{{restDisplay}}</view>
  <view class="rf-mid">
    <view class="rf-label">{{restLabel}}</view>
    <view class="rf-sub">{{restPhase || (restLeft?(restRunning?"计时中":"已暂停"):"计时结束")}}</view>
  </view>
  <view wx:if="{{timerKind==='rest'}}" class="rf-btn rf-focus" bindtap="fmOpen">专注训练</view>
  <view wx:if="{{restLeft}}" class="rf-btn" bindtap="pauseRest">{{restRunning?"暂停":"继续"}}</view><view wx:if="{{restLeft && !restPhase}}" class="rf-btn" bindtap="addRest30">+30秒</view>
  <view class="rf-btn rf-skip" bindtap="skipRest">跳过</view>
</view>

<!-- 专注训练全屏：大倒计时 + 动作大图 + 当前组填写，点「完成」=打勾并进入休息 -->
<view wx:if="{{fm.on}}" class="fm">
  <view class="fm-top">
    <view class="fm-title">{{fm.exName}}</view>
    <view class="fm-close" bindtap="fmClose">收起 ✕</view>
  </view>
  <view class="fm-imgwrap">
    <block wx:for="{{fm.media}}" wx:key="id"><frame-gif frames="{{item.frames}}" equip="{{fm.equipment}}" interactive="{{true}}"/></block>

  </view>
  <view class="fm-set">第 {{fm.si+1}} / {{fm.totalSets}} 组</view><view class="fm-fill"><button size="mini" data-d="-1" bindtap="fmChangeSets">− 减一组</button><button size="mini" data-d="1" bindtap="fmChangeSets">＋ 加一组</button></view>
  <view class="fm-timer {{fm.restLeft>0?'resting':''}}">{{fm.restLeft>0 ? fm.restLeft : '─'}}<text wx:if="{{fm.restLeft>0}}" class="fm-ts">s</text></view>
  <view class="fm-sub">{{fm.restLeft>0 ? fm.restLabel : '做这一组 —— 重量次数先调好，练完点大按钮'}}</view>
  <view class="fm-fill">
    <view class="fm-step" data-f="weight" data-d="-1" bindtap="fmAdj">{{fm.hasRack ? '上一档' : '−' + fm.weightStep}}</view>
    <view class="fm-val fm-pick" bindtap="fmPickW">{{fm.weight!=='' && fm.weight!==null && fm.weight!==undefined ? fm.weight + ' kg' : '自重'}}</view>
    <view class="fm-step" data-f="weight" data-d="1" bindtap="fmAdj">{{fm.hasRack ? '下一档' : '+' + fm.weightStep}}</view>
  </view>
  <view class="fm-fill">
    <view class="fm-step" data-f="reps" data-d="-1" bindtap="fmAdj">−1</view>
    <view class="fm-val fm-pick" bindtap="fmPickR">{{fm.reps}} {{fm.unit}}</view>
    <view class="fm-step" data-f="reps" data-d="1" bindtap="fmAdj">+1</view>
  </view>
  <view class="fm-done" bindtap="fmDone">✓ 完成这一组</view>
  <scroll-view scroll-y class="fm-points"><text>{{fm.points}}</text></scroll-view>
</view>

<!-- 动作库选择弹层（与网站 openPicker 同款：搜索 + 分类 + 列表） -->
<view wx:if="{{pk.on}}" class="pk-mask" bindtap="closePk">
  <view class="pk-box" catchtap="noop">
    <view class="pk-head">
      <text class="pk-title">{{pk.mode === 'add' ? '＋ 添加动作' : '换成什么动作'}}</text>
      <view class="pk-close" bindtap="closePk">关闭</view>
    </view>
    <input class="pk-search" placeholder="搜索动作，如：卧推 / 划船 / 下拉" value="{{pk.q}}" bindinput="pkInput"/>
    <scroll-view scroll-x class="pk-cats" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{pk.cats}}" wx:key="*this" class="pk-cat {{pk.cat === item ? 'on' : ''}}" data-cat="{{item}}" bindtap="pkCat">{{item}}</view>
    </scroll-view>
    <scroll-view scroll-y class="pk-list">
      <view wx:for="{{pk.list}}" wx:key="name" class="pk-i" data-i="{{index}}" bindtap="pickPk">
        <text class="pk-n">{{item.name}}</text>
        <text class="pk-m">{{item.meta}}</text>
      </view>
      <view wx:if="{{!pk.list.length}}" class="muted" style="padding:32rpx;text-align:center">没有找到，换个词试试</view>
      <view class="pk-foot" bindtap="pkCustom">没找到？手动输入动作名 →</view>
    </scroll-view>
    <view class="pk-tip">{{pk.tip}}</view>
  </view>
</view>

<!-- 练前「内视」自评（2026-10-17 与网站同款：每天一次，只建议不强制） -->
<view wx:if="{{preOn}}" class="pre-mask">
  <view class="pre-card">
    <view class="title">开练前，内视一下</view>
    <view class="muted" style="margin:6rpx 0 10rpx">四项各打 1-5 分。玄衡按你的状态给今日建议——只建议，不动你的计划。</view>
    <view class="pre-total">总分 {{preTotal}} / 20</view>
    <view class="pre-row" wx:for="{{preDims}}" wx:key="k">
      <view class="pre-h"><text class="pre-l">{{item.label}}</text><text class="pre-v">{{item.v}} 分</text></view>
      <slider min="1" max="5" step="1" value="{{item.v}}" show-value activeColor="#90c8a4" block-size="20" data-i="{{index}}" bindchanging="preChanging"/>
      <view class="pre-lo"><text>{{item.lo}}</text><text>{{item.hi}}</text></view>
    </view>
    <view class="btn block" bindtap="preSubmit">就绪，开始练</view>
    <view class="pre-foot">每天只问一次 · 不会自动改你的重量和组数</view>
  </view>
</view>


<view wx:if="{{pgOpen}}" class="pg-mask">
 <scroll-view scroll-y class="pg-panel"><view class="title">{{pgName}} · 递进起点</view><view class="muted">按实际能力设置。哑铃按每只重量，助力越小越难，已完成记录保留。</view>
 <picker range="{{pgKinds}}" value="{{pgKindIndex}}" bindchange="pgKind"><view class="pg-field">类型：{{pgKinds[pgKindIndex]}} ›</view></picker>
 <view class="pg-field">工作组数<input type="number" value="{{pgForm.sets}}" data-k="sets" bindinput="pgInput"/></view>
 <view class="pg-field">次数 / 秒数下限<input type="number" value="{{pgForm.min}}" data-k="min" bindinput="pgInput"/></view>
 <view class="pg-field">次数 / 秒数上限<input type="number" value="{{pgForm.max}}" data-k="max" bindinput="pgInput"/></view>
 <view class="pg-field">起始重量kg（自重 / 计时填0）<input type="digit" value="{{pgForm.weight}}" data-k="weight" bindinput="pgInput"/></view>
 <view class="pg-field">最小加重档位kg<input type="digit" value="{{pgForm.step}}" data-k="step" bindinput="pgInput"/></view>
 <view class="pg-field">可用重量档位（选填，逗号分隔）<input value="{{pgForm.weights}}" data-k="weights" bindinput="pgInput" placeholder="例如 2,4,6,8"/></view>
 <view wx:if="{{pgHad}}" class="pg-field"><switch checked="{{pgOff}}" bindchange="pgOff"/>关闭递进，恢复原计划</view>
 <button bindtap="pgSave">确认设置</button><button bindtap="pgClose">取消</button><view style="height:40rpx"></view>
 </scroll-view>
</view>
