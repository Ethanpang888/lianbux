<view class="card">
 <view class="tabs"><button wx:for="{{meals}}" wx:key="k" class="{{meal===item.k?'on':''}}" data-k="{{item.k}}" bindtap="meal">{{item.name}}</button></view>
 <view class="tabs"><button wx:for="{{tabs}}" wx:key="k" class="{{tab===item.k?'on':''}}" data-k="{{item.k}}" bindtap="tab">{{item.name}}</button></view>
 <input class="search" placeholder="搜索食物，例如米饭、鸡蛋" value="{{q}}" bindinput="search"/>
 <view wx:if="{{tab==='lib'}}" class="categories"><button wx:for="{{cats}}" wx:key="*this" class="{{cat===item?'on':''}}" data-c="{{item}}" bindtap="cat">{{item}}</button></view>
 <button wx:if="{{tab==='lib'}}" bindtap="openCustom">没找到？添加自定义食物</button>
 <block wx:if="{{tab!=='tpl'}}"><view wx:for="{{foods}}" wx:key="name" class="foodrow" data-i="{{index}}" bindtap="pick"><view>{{item.name}}<view class="muted">{{item.kcal}} 大卡 / 100克 · 以库内生熟重为准</view></view><text class="plus">＋</text></view><view wx:if="{{!foods.length}}" class="muted">还没有食物，切换食物库添加。已记录的食物会出现在常用。</view></block>
 <block wx:else><view wx:for="{{tpls}}" wx:key="name" class="foodrow"><view data-i="{{index}}" bindtap="viewTpl">{{item.name}} · {{item.items.length}}项 · 查看/编辑</view><button data-i="{{index}}" bindtap="delTpl">删除</button></view><view wx:if="{{!tpls.length}}" class="muted">记录一餐后，可在下方保存套餐。</view></block>
</view>
<view class="card"><view class="title">本餐已吃记录</view><view wx:if="{{busy}}" class="muted">正在保存…</view><view wx:for="{{entries}}" wx:key="idx" class="foodrow"><view>{{item.name}} {{item.grams||item.g}}g {{item.unknown?'（营养未知）':''}}<view class="muted">{{item.kcal}} kcal</view></view><button data-i="{{item.idx}}" bindtap="edit">修改</button><button data-i="{{item.idx}}" bindtap="remove">删除</button></view><button bindtap="saveTpl">把这餐存为套餐</button><button data-day="{{true}}" bindtap="saveTpl">保存全天套餐</button><button bindtap="refresh">刷新记录</button></view>
<view wx:if="{{tplDraft}}" class="editor"><view class="card"><view class="title">编辑套餐</view><input value="{{tplDraft.name}}" bindinput="tplName"/><view wx:for="{{tplDraft.items}}" wx:key="index" class="foodrow"><text>{{item.name}}</text><input type="digit" value="{{item.grams}}" data-i="{{index}}" bindinput="tplG"/><text>克</text></view><button bindtap="saveTplEdit">保存修改</button><button bindtap="applyTpl">确认份量并记入</button><button bindtap="closeTpl">取消</button></view></view>

<view wx:if="{{custom}}" class="editor"><view class="card"><view class="title">自定义食物</view><input placeholder="食物名称" value="{{custom.name}}" data-k="name" bindinput="customInput"/><view class="muted">有标签可填每100g营养；不填热量则标记营养未知，不当成零热量。</view><view wx:for="{{customFields}}" wx:key="k" class="foodrow"><text>{{item.name}}</text><input type="digit" data-k="{{item.k}}" value="{{custom[item.k]}}" bindinput="customInput"/></view><button bindtap="saveCustom">保存并记入</button><button bindtap="closeCustom">取消</button></view></view>
