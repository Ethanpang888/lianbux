.tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx;margin-bottom:20rpx}.tabs button,.categories button{font-size:24rpx;padding:4rpx 0;width:100%}.on{color:#cf9757!important;background:rgba(207,151,87,.15)!important}.categories{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin:20rpx 0}.foodrow{display:flex;align-items:center;gap:12rpx;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid var(--line)}.foodrow>view:first-child{flex:1}.foodrow button{font-size:22rpx;margin:0;padding:0 12rpx}.foodrow input{width:130rpx;text-align:center;border:1rpx solid var(--line);padding:12rpx}.plus{font-size:45rpx;color:#cf9757}.muted{font-size:23rpx;margin-top:8rpx;line-height:1.6}.search{padding:20rpx;background:var(--bg);border-radius:16rpx;font-size:28rpx}.editor{position:fixed;inset:0;z-index:1000;overflow:auto;background:rgba(0,0,0,.85);padding:70rpx 20rpx}.editor input{padding:20rpx;border:1rpx solid var(--line)}