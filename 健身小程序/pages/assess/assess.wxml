<page-meta page-style="{{themeStyle}}"/>
<view class="page-heading">{{isEdit?'修改档案':'建档'}}<view class="page-sub">{{isEdit?'改完会重算训练计划与饮食':'1分钟 · 之后随时能改'}}</view></view>
<view class="card assess-card"><view class="title">基本</view>
 <view class="form-field"><text class="field-label">称呼</text><input class="form-input" value="{{draft.nick}}" data-k="nick" bindinput="input" maxlength="12" placeholder="可留空"/></view>
 <view class="form-label">性别</view><view class="form-chips"><button wx:for="{{['男','女']}}" wx:key="*this" class="form-chip {{draft.gender===item?'on':''}}" data-k="gender" data-v="{{item}}" bindtap="pick">{{item}}</button></view>
 <view class="form-field"><text class="field-label">年龄</text><view class="input-unit"><input class="form-input" type="number" value="{{draft.age}}" data-k="age" bindinput="input"/><text>岁</text></view></view>
 <view class="form-field"><text class="field-label">身高</text><view class="input-unit"><input class="form-input" type="digit" value="{{draft.height}}" data-k="height" bindinput="input"/><text>cm</text></view></view>
 <view class="form-field"><text class="field-label">体重</text><view class="input-unit"><input class="form-input" type="digit" value="{{draft.weight}}" data-k="weight" bindinput="input"/><text>kg</text></view></view><view class="form-hint">早起空腹称最准，之后可随时改。</view>
</view>
<view class="card assess-card"><view class="title">目标</view><view class="form-chips"><button wx:for="{{goals}}" wx:key="v" class="form-chip {{draft.goal===item.v?'on':''}}" data-k="goal" data-v="{{item.v}}" bindtap="pick">{{item.label}}</button></view>
 <view wx:if="{{pace}}" class="goal-sub"><view class="form-label">减脂力度</view><view class="form-chips"><button wx:for="{{paces}}" wx:key="v" class="form-chip {{draft.fatLossPace===item.v?'on':''}} {{item.v==='intensive'&&!pace.eligible?'disabled':''}}" disabled="{{item.v==='intensive'&&!pace.eligible}}" data-k="fatLossPace" data-v="{{item.v}}" bindtap="pick">{{item.label}}</button></view><view class="form-hint">{{pace.note}}</view><view class="form-hint">{{pace.reason||('预计每天 '+pace.kcal+' 大卡 · 缺口约 '+pace.deficit+' 大卡')}}</view></view>
 <view wx:else class="form-hint">按所选目标计算热量与营养，之后可以在“我的”修改。</view>
</view>
<view class="card assess-card"><view class="title">训练安排</view>
 <view class="form-label">练了多久</view><view class="form-chips"><button wx:for="{{exps}}" wx:key="v" class="form-chip {{draft.exp===item.v?'on':''}}" data-k="exp" data-v="{{item.v}}" bindtap="pick">{{item.label}}</button></view>
 <view class="form-label">每周能练几天</view><view class="form-chips"><button wx:for="{{dayOpts}}" wx:key="*this" class="form-chip {{draft.days==item?'on':''}}" data-k="days" data-v="{{item}}" bindtap="pick">{{item}}天</button></view>
 <view class="form-label">循环方式 <text class="form-hint">按每周天数推荐，可改</text></view><view class="form-hint">按周：固定星期训练。循环制：练N天休1天，不受星期限制。</view>
 <view class="form-chips"><button wx:for="{{weekOpts}}" wx:key="key" class="form-chip {{effFreq===item.key?'on':''}}" data-k="freq" data-v="{{item.key}}" bindtap="pick">{{item.name}}</button></view><view class="form-chips"><button wx:for="{{cycleOpts}}" wx:key="key" class="form-chip {{effFreq===item.key?'on':''}}" data-k="freq" data-v="{{item.key}}" bindtap="pick">{{item.name}}</button></view>
 <view class="form-label">分化方式 <text class="form-hint">按经验与循环推荐，可改</text></view><view class="form-list"><button wx:for="{{splitOpts}}" wx:key="key" class="form-option {{effSplit===item.key?'on':''}}" data-k="split" data-v="{{item.key}}" bindtap="pick"><view class="option-heading">{{item.name}}<text class="form-hint">{{item.level}}</text></view><view class="form-hint">{{item.basis}}</view></button></view><view class="form-hint combo-hint">{{comboHint}}</view>
 <view class="form-label">在哪练</view><view class="form-chips"><button class="form-chip {{draft.home==='0'?'on':''}}" data-k="home" data-v="0" bindtap="pick">健身房</button><button class="form-chip {{draft.home==='1'?'on':''}}" data-k="home" data-v="1" bindtap="pick">居家</button></view>
 <view class="form-label">精选课表（可选）</view><view class="form-chips"><button class="form-chip {{draft.progMode==='smart'?'on':''}}" data-k="progMode" data-v="smart" bindtap="pick">智能生成</button><button class="form-chip {{draft.progMode==='program'?'on':''}}" data-k="progMode" data-v="program" bindtap="pick">精选课表</button></view><block wx:if="{{draft.progMode==='program'}}"><view class="form-hint">选用课表自带的周期与分化，上方安排不参与本次生成。</view><view class="form-chips"><button wx:for="{{progList}}" wx:key="key" class="form-chip {{draft.program===item.key?'on':''}}" data-k="program" data-v="{{item.key}}" bindtap="pick">{{item.name}}</button></view></block>
</view>
<view class="card assess-card"><view class="title">日常活动量 <text class="form-hint">这一项影响最大</text></view><view class="form-list"><button wx:for="{{activities}}" wx:key="key" class="form-option {{draft.activity===item.key?'on':''}}" data-k="activity" data-v="{{item.key}}" bindtap="pick"><view class="option-heading">{{item.name}}<text class="form-hint">×{{item.factor}}</text></view><view class="form-hint">{{item.desc}}</view></button></view><view class="form-hint combo-hint">{{activityHint}}</view></view>
<view class="card assess-card"><view class="title">饮食方案</view><view class="form-label">怎么给量</view><view class="form-chips"><button class="form-chip {{draft.dietMode==='simple'?'on':''}}" data-k="dietMode" data-v="simple" bindtap="pick">只给克数（自由搭）</button><button class="form-chip {{draft.dietMode==='recipe'?'on':''}}" data-k="dietMode" data-v="recipe" bindtap="pick">帮我配好菜</button></view><view class="form-label">体质（决定碳水基准）</view><view class="form-chips"><button wx:for="{{bodyTypes}}" wx:key="v" class="form-chip {{draft.bodyType===item.v?'on':''}}" data-k="bodyType" data-v="{{item.v}}" bindtap="pick">{{item.label}}</button></view><view class="form-hint">碳水基准：易胖2.5 / 中性3.0 / 易瘦3.5g/kg；每日目标按总消耗计算。</view></view>
<view class="card assess-card"><view class="title">城市 <text class="form-hint">可跳过</text></view><view class="form-hint">只用来显示同城排行榜，不开定位。</view><view class="form-chips"><button wx:for="{{cities}}" wx:key="*this" class="form-chip {{draft.city===item?'on':''}}" data-k="city" data-v="{{item}}" bindtap="pick">{{item}}</button></view></view>
<view class="card assess-card"><view class="title">有师傅带你？ <text class="form-hint">可跳过</text></view><view class="form-hint">填朋友的邀请码（LB开头），你和他各得3天完整版。一个账号只认一个师傅。</view><input class="invite-input" value="{{draft.invite}}" data-k="invite" bindinput="input" placeholder="LB开头的邀请码（没有就跳过）"/></view>
<view wx:if="{{result}}" class="card assess-card"><view class="title">你的每日消耗与目标</view><view class="form-hint">基础代谢 {{result.bmr}} × 活动系数 = 总消耗 {{result.tdee}} 大卡</view><view class="form-hint">每日 {{result.kcal}} 大卡 · 蛋白质 {{result.protein}}g · 碳水 {{result.carb}}g · 脂肪 {{result.fat}}g</view></view>
<view class="assess-actions"><button class="btn" disabled="{{saving}}" loading="{{saving}}" bindtap="submit">{{isEdit?'保存并重算计划':'完成建档，生成我的计划'}}</button><button wx:if="{{isEdit}}" class="btn ghost" disabled="{{saving}}" bindtap="cancel">取消</button></view>
