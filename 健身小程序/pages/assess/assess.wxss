.assess-card .title{margin-bottom:20rpx}.form-field{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:20rpx 0;border-bottom:1rpx solid var(--line)}.field-label{font-size:26rpx;flex-shrink:0}.form-input{min-width:0;width:260rpx;text-align:right;background:var(--bg);border-radius:12rpx;padding:12rpx 16rpx;box-sizing:border-box;font-size:28rpx}.input-unit{display:flex;align-items:center;gap:12rpx;font-size:24rpx;color:var(--sub)}.input-unit .form-input{width:180rpx}.form-label{font-size:26rpx;margin:24rpx 0 12rpx;font-weight:550}.form-chips{display:flex;flex-wrap:wrap;gap:12rpx;margin:12rpx 0}.form-chips>.form-chip{width:auto;min-width:0;margin:0;padding:12rpx 20rpx;border-radius:999rpx;font-size:24rpx;line-height:1.5;background:var(--bg);color:var(--text);box-sizing:border-box}.form-chips>.form-chip.on{background:var(--green);color:var(--button-text)}.form-chips>.form-chip.disabled{opacity:.45}.form-hint{font-size:22rpx;font-weight:400;line-height:1.65;color:var(--sub);margin-top:8rpx}.goal-sub{margin-top:24rpx;border-left:3rpx solid var(--line);padding-left:24rpx}.goal-sub .form-label{font-size:24rpx;margin-top:0}.form-list{display:flex;flex-direction:column;gap:12rpx;margin-top:20rpx}.form-list>.form-option{width:100%;min-width:0;box-sizing:border-box;margin:0;text-align:left;white-space:normal;padding:20rpx;border:2rpx solid var(--line);border-radius:20rpx;background:var(--bg);color:var(--text);line-height:1.5}.form-list>.form-option.on{border-color:var(--green);background:var(--green-soft)}.option-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12rpx;font-size:26rpx;font-weight:600}.option-heading .form-hint{flex-shrink:0}.combo-hint{background:var(--green-soft);padding:18rpx;border-radius:14rpx;margin-top:20rpx}.invite-input{padding:20rpx;background:var(--bg);border-radius:16rpx;font-size:24rpx;margin-top:20rpx}.assess-actions{margin:0 40rpx 32rpx}.assess-actions .btn{margin-top:16rpx}
