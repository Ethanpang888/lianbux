/* pages/ai/ai.wxss —— 随身导师 */
page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

.topbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 28rpx 10rpx;
}
.clear { color: var(--sub); font-size: 24rpx; padding: 8rpx 16rpx; }

.chat { flex: 1; padding: 10rpx 20rpx; box-sizing: border-box; }

.msg { display: flex; margin: 14rpx 0; }
.msg.user { justify-content: flex-end; }
.bubble {
  max-width: 82%; border-radius: 20rpx; padding: 20rpx 24rpx;
  font-size: 27rpx; line-height: 1.6; word-break: break-all;
}
.bubble.user { background: var(--green); color: #12291b; border-bottom-right-radius: 6rpx; }
.bubble.assistant { background: var(--card); color: var(--text); border-bottom-left-radius: 6rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04); }

.hello { margin: 20rpx 8rpx; }

.errbar {
  margin: 14rpx 0; padding: 18rpx 22rpx; border-radius: 16rpx;
  background: var(--warn-soft); color: var(--warn); font-size: 24rpx;
  display: flex; justify-content: space-between; align-items: center;
}
.retry { color: var(--warn); font-weight: 700; margin-left: 16rpx; flex-shrink: 0; }

.quick { display: flex; flex-wrap: wrap; padding: 8rpx 20rpx; }
.qchip {
  background: var(--card); border: 1rpx solid var(--line); border-radius: 999rpx;
  padding: 12rpx 22rpx; margin: 8rpx 12rpx 8rpx 0; font-size: 24rpx; color: var(--green-dark);
}

.inputbar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card); border-top: 1rpx solid var(--line);
}
.ipt {
  flex: 1; background: var(--bg); border-radius: 999rpx;
  padding: 18rpx 26rpx; font-size: 27rpx;
}
.send {
  background: var(--green); color: #12291b; border-radius: 999rpx;
  padding: 16rpx 32rpx; font-size: 27rpx; font-weight: 600; flex-shrink: 0;
}
.send.off { opacity: 0.5; }
.quota { padding: 4rpx 28rpx 10rpx; text-align: right; }
