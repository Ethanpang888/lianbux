/* pages/tcm/tcm.wxss —— 中医调理板块 */
.page { padding: 24rpx 24rpx 60rpx; }

/* 免责声明 */
.disc {
  background: var(--warn-soft); color: var(--warn); font-size: 22rpx; line-height: 1.5;
  padding: 16rpx 20rpx; border-radius: 12rpx; border: 1rpx solid rgba(213,189,135,0.35); margin-bottom: 20rpx;
}

/* 顶部 hero */
.hero { background: linear-gradient(135deg,#1d2b20,#233c2c); border-radius: 20rpx; padding: 36rpx 28rpx; margin-bottom: 24rpx; }
.hero-t { font-size: 38rpx; font-weight: 700; color: var(--green-dark); }
.hero-s { font-size: 24rpx; color: var(--green-dark); opacity: .8; margin: 12rpx 0 24rpx; }
.btn-primary { background: var(--green); color: var(--button-text); font-size: 30rpx; border-radius: 999rpx; padding: 16rpx 0; }

/* 结果卡 */
.card { background: var(--card); border-radius: 18rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.res-head { display: flex; align-items: center; justify-content: space-between; }
.res-name { font-size: 36rpx; font-weight: 700; color: var(--green-dark); }
.res-tag { font-size: 22rpx; color: var(--button-text); background: var(--green); padding: 4rpx 16rpx; border-radius: 999rpx; }
.res-desc { font-size: 26rpx; color: var(--text); margin: 16rpx 0 20rpx; line-height: 1.6; }
.res-sec .rs { display: flex; padding: 14rpx 0; border-top: 1rpx solid var(--bg); }
.rs-l { flex: 0 0 130rpx; font-size: 24rpx; color: var(--green); font-weight: 600; }
.rs-v { flex: 1; font-size: 26rpx; color: var(--text); line-height: 1.6; }
.rs.tip .rs-v { color: #e5726f; }
.res-reset { text-align: center; font-size: 24rpx; color: var(--sub); margin-top: 18rpx; }

/* 区块标题 */
.sec { margin-bottom: 28rpx; }
.sec-t { font-size: 30rpx; font-weight: 700; color: var(--text); margin-bottom: 16rpx; padding-left: 16rpx; border-left: 8rpx solid var(--green); }

/* 体质快选 chips */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { background: var(--card); border: 1rpx solid var(--line); color: var(--green-dark); font-size: 26rpx; padding: 14rpx 28rpx; border-radius: 999rpx; }
.chip.on { background: var(--green); color: var(--button-text); border-color: var(--green); }

/* 概念库小课堂 */
.lessons { display: flex; flex-direction: column; gap: 16rpx; }
.lesson { background: var(--card); border-radius: 14rpx; padding: 22rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.04); }
.le-t { font-size: 28rpx; font-weight: 700; color: var(--green-dark); margin-bottom: 8rpx; }
.le-b { font-size: 25rpx; color: var(--text); line-height: 1.6; }

/* 食养 / 训练 rows */
.row { background: var(--card); border-radius: 14rpx; padding: 20rpx 22rpx; margin-bottom: 14rpx; }
.row-l { font-size: 27rpx; font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 12rpx; }
.row-tag { font-size: 20rpx; color: var(--green-dark); background: var(--green-soft); padding: 2rpx 12rpx; border-radius: 999rpx; }
.row-d { font-size: 25rpx; color: var(--sub); line-height: 1.6; margin-top: 8rpx; }

/* 四季 */
.seasons { display: flex; flex-wrap: wrap; gap: 14rpx; }
.season { flex: 1 1 46%; background: var(--card); border-radius: 14rpx; padding: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.04); }
.se-s { font-size: 32rpx; font-weight: 700; color: var(--green); margin-right: 12rpx; }
.se-d { font-size: 24rpx; color: var(--sub); line-height: 1.6; }

/* 自测浮层 */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: flex; align-items: center; justify-content: center; z-index: 100; }
.quiz { width: 86%; background: var(--card); border-radius: 22rpx; padding: 40rpx 32rpx; box-sizing: border-box; }
.q-prog { font-size: 24rpx; color: var(--sub); text-align: center; margin-bottom: 24rpx; }
.q-txt { font-size: 34rpx; font-weight: 700; color: var(--text); line-height: 1.6; text-align: center; margin-bottom: 32rpx; }
.q-opts { display: flex; flex-direction: column; gap: 16rpx; }
.q-opt { background: var(--green-soft); color: var(--green-dark); font-size: 30rpx; text-align: center; padding: 22rpx 0; border-radius: 14rpx; border: 1rpx solid var(--line); }
.q-opt:active { background: var(--green-soft); }
.q-foot { font-size: 22rpx; color: var(--sub); text-align: center; margin-top: 24rpx; }
.q-title { font-size: 34rpx; font-weight: 700; text-align: center; color: var(--green-dark); margin-bottom: 24rpx; }
.q-res { font-size: 30rpx; text-align: center; color: var(--text); }
.q-res .hl { color: var(--green); font-weight: 700; font-size: 36rpx; }
.q-res2 { font-size: 26rpx; text-align: center; color: var(--sub); margin-top: 12rpx; }
.q-disc { font-size: 21rpx; color: var(--warn); background: var(--warn-soft); border-radius: 10rpx; padding: 14rpx 16rpx; line-height: 1.5; margin: 24rpx 0; }
.q-btn { background: var(--green); color: var(--button-text); font-size: 30rpx; text-align: center; padding: 22rpx 0; border-radius: 14rpx; }

/* 食养方库 */
.fgrp { margin-top: 16rpx; }
.fgrp-t { font-size: 27rpx; font-weight: 700; color: var(--green); margin: 14rpx 0 10rpx; }
.recipe { background: var(--card); border-radius: 14rpx; padding: 20rpx 22rpx; margin-bottom: 14rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.04); }
.r-name { font-size: 28rpx; font-weight: 700; color: var(--green-dark); }
.r-line { font-size: 24rpx; color: var(--text); margin-top: 6rpx; line-height: 1.5; }
.r-l { display: inline-block; width: 76rpx; color: var(--sub); }
.toggle { font-size: 24rpx; color: var(--green); margin-top: 8rpx; }
.sec-n { font-size: 22rpx; color: var(--sub); font-weight: 400; }

/* 节气养生 */
.solar-grp { margin-top: 16rpx; }
.solar-season { font-size: 27rpx; font-weight: 700; color: var(--green); margin: 14rpx 0 10rpx; }
.solar-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.solar-item { flex: 1 1 30%; background: var(--card); border-radius: 12rpx; padding: 14rpx 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.sv-s { font-size: 25rpx; font-weight: 700; color: var(--green-dark); margin-right: 8rpx; }
.sv-d { font-size: 22rpx; color: var(--sub); line-height: 1.5; }

/* 五脏 × 训练 */
.wz { background: var(--card); border-radius: 14rpx; padding: 22rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.04); }
.wz-h { display: flex; align-items: baseline; gap: 14rpx; margin-bottom: 10rpx; }
.wz-z { font-size: 28rpx; font-weight: 700; color: var(--green-dark); }
.wz-f { font-size: 24rpx; color: var(--green); }
.wz-b { font-size: 25rpx; color: var(--text); line-height: 1.6; }

.page{padding:0 40rpx}.page .card{margin:0 0 28rpx}.sec{border:1rpx solid var(--line);border-radius:28rpx;padding:28rpx;background:var(--card)}.sec-t{border:0;padding:0;margin:0;font-size:28rpx;display:flex;justify-content:space-between}.sec-t+block{margin-top:20rpx}.hero{background:var(--green-soft)}.hero-t{color:var(--text)}.hero-s{color:var(--sub)}.btn-primary,.q-btn{background:var(--green);color:var(--button-text)}
