<page-meta page-style="{{themeStyle}}"/>
<view class="page-heading"><view class="page-title">我的</view><view class="muted">档案与修炼工具</view></view>
<view wx:if="{{!profile}}" class="card center-empty"><view class="title">还没有资料</view><button class="btn" bindtap="edit">去建档</button></view>
<block wx:else>
<view class="card" data-section="profile"><view class="title">档案 <text class="mini">{{profile.exp}}</text></view><view class="kv4"><view><text class="muted">体重 kg</text><view>{{profile.weight}}</view></view><view><text class="muted">身高 cm</text><view>{{profile.height}}</view></view><view><text class="muted">目标</text><view>{{profile.goal}}</view></view><view><text class="muted">活动</text><view>{{activity}}</view></view></view><button class="btn ghost" bindtap="edit">修改档案（体重变了记得改）</button><view class="muted">BMI {{bmi}} · 每周 {{profile.days}} 练 · {{profile.home?'居家':'健身房'}}</view></view>
<view class="card" data-section="tools"><view class="title">修炼工具</view><view wx:for="{{tools}}" wx:key="key" class="tool-link" data-url="{{item.url}}" bindtap="goTool"><view><view>{{item.name}}</view><view class="muted">{{item.note}}</view></view><text>›</text></view><view class="tool-link" data-mode="today" bindtap="poster"><view>今日战报<view class="muted">本次举铁多少吨 · 昭告天下</view></view><text>›</text></view><view class="tool-link" data-mode="life" bindtap="poster"><view>修行生涯卡<view class="muted">累计举起 · 连续修炼 · 入坑天数</view></view><text>›</text></view><button class="btn ghost" loading="{{exporting}}" bindtap="exportData">导出我的数据（JSON）</button><view class="muted">档案 + 计划 + 全部打卡；照片文件仅存本机，导出文件包含本机照片路径。</view></view>
<view class="card" data-section="rank"><view class="title">排行榜 <text class="mini">同城 / 全国</text></view><view class="tool-link"><text class="muted">我的城市</text><text>{{profile.city||'未设置'}}</text></view><view class="chips"><text wx:for="{{cities}}" wx:key="*this" class="chip {{profile.city===item?'on':''}}" data-city="{{item}}" bindtap="setCity">{{item}}</text></view><button class="btn ghost" bindtap="goRank">看排行榜</button></view>
<view class="card" data-section="member"><view class="title">完整版 <text class="mini">{{member.valid?member.name:'未开通'}}</text></view><view class="muted" style="margin-top:16rpx">{{member.valid?'每个动作的具体重量、周期表、状态微调和完整饮食。':'免费版给动作、组次与打卡；完整版增加具体重量、周期表、完整饮食与目标秘籍。'}}</view><view wx:if="{{member.valid}}" class="muted">到期 {{member.expiresAt}} · 还剩 {{member.days}} 天</view><button class="btn ghost" bindtap="goPro">{{member.valid?'打开完整版计划':'看看里面有什么'}}</button><button class="btn ghost" bindtap="goSecret">看秘籍</button></view>
  <!-- 收徒（裂变，2026-10-17）：邀请码 + 弟子 + 绑定师傅 -->
  <view class="card" data-section="invite">
    <view class="title">广收门徒 <text class="mini">同门师兄弟 · 一起炼</text></view>
    <view class="muted" style="margin:6rpx 0;line-height:1.6">把邀请码发给想练的人——他注册时填码，<text class="strong">你和他各得 3 天完整版</text>。谁先玩谁就是师傅。</view>
    <view class="row between" style="margin-top:10rpx">
      <text class="inv-code">{{inviteCode || '获取中…'}}</text>
      <view class="btn ghost" style="width:auto;padding:8rpx 24rpx;font-size:24rpx" bindtap="copyInvite">复制</view>
    </view>
    <view style="display:flex;gap:14rpx;margin-top:14rpx">
      <view class="btn ghost" style="flex:1" bindtap="myInvites">我的弟子</view>
      <view class="btn ghost" style="flex:1" bindtap="bindInvite">{{inviterCode ? '已拜师 · ' + inviterCode : '绑定师傅的邀请码'}}</view>
    </view>
  </view>


<view class="card" data-section="characters"><view class="title">我的形象 <text class="mini">当前『{{stageName}}』</text></view><view class="stage-row"><view wx:for="{{stages}}" wx:key="at" class="stage-tile {{item.unlocked?'':'locked'}} {{item.current?'cur':''}}"><image src="/assets/characters/{{item.file}}" mode="aspectFit"/><view>Lv{{item.at}}</view><text>{{item.name}}</text></view></view><view class="muted">形象随等级变化，持续训练解锁下一阶段。</view></view>
<view class="card" data-section="level"><view class="title">等级与经验</view><view class="tool-link"><text class="muted">境界</text><text>{{cul.realm}}</text></view><view class="tool-link"><text class="muted">等级</text><text>Lv {{cul.level}} · {{cul.title}}</text></view><view class="tool-link"><text class="muted">总经验</text><text>{{cul.exp}} EXP</text></view><view class="tool-link"><text class="muted">距离下一级</text><text>{{cul.toNext}} EXP</text></view><view class="tool-link"><text class="muted">徽章</text><text>{{badgeGot||0}} / {{badges.length||0}}</text></view><button class="btn ghost" bindtap="goGrowth">查看徽章墙与成长记录</button></view>
<view class="card" data-section="theme"><view class="title">外观</view><view class="chips"><text class="chip {{theme==='light'?'on':''}}" data-theme="light" bindtap="setTheme">明亮</text><text class="chip {{theme==='dark'?'on':''}}" data-theme="dark" bindtap="setTheme">深空（深色）</text></view><view class="muted">选择你看着舒服的颜色。</view></view>
<view class="card" data-section="account"><view class="title">账号 <text class="mini">微信已登录</text></view><view class="tool-link"><text class="muted">玩家编号</text><text>{{playerNo||'绑定网站后同步'}}</text></view><view wx:if="{{email}}" class="tool-link"><text class="muted">邮箱</text><text>{{email}}</text></view><view class="tool-link"><text class="muted">云端状态</text><text>{{syncing?'同步中…':syncError?'同步失败，请重试':'已连接'}}</text></view><button class="btn ghost" bindtap="refreshAccount" loading="{{syncing}}">立即同步</button><button class="btn ghost" bindtap="goBind">绑定 / 解绑网站账号</button><view class="muted">绑定后两端打卡互通，排行榜共用同一个榜。</view><button class="btn ghost" bindtap="goSubscribe">每日邮件订阅</button><button class="btn ghost" style="color:var(--danger)" bindtap="clear">清空本账号数据（永久删除）</button></view>
<view class="card" data-section="technical"><view class="tool-link" bindtap="toggleTech"><view class="title">技术信息与引擎状态</view><text>{{techOpen?'−':'＋'}}</text></view><block wx:if="{{techOpen}}"><view class="muted">计算、计划、饮食、游戏化：已加载 · 双端共用规则</view><button class="btn ghost" bindtap="about">使用说明与免责声明</button></block></view>
</block>
