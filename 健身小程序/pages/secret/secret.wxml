<!--pages/secret/secret.wxml——藏经阁-->

<!-- ═══════════ 列表 ═══════════ -->
<block wx:if="{{view === 'list'}}">
  <view class="lead">
    <view class="lead-eyebrow">修行，从一本开始</view>
    <view class="lead-title">找到今天用得上的功法。</view>
    <view class="muted">基础功法完整免费；居家、部位专项、体态矫正按需挑选。</view>
  </view>

  <scroll-view class="tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tab {{tab === t.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key"
          wx:for-item="t" bindtap="switchTab" data-tab="{{t.key}}">{{t.name}}</view>
  </scroll-view>

  <view class="btn ghost block" wx:if="{{hasBackup}}" bindtap="restoreBackup" style="margin-bottom:16rpx">↩ 换回挂秘籍之前的计划</view>

  <!-- 基础功法（免费） -->
  <block wx:for="{{books}}" wx:key="key">
    <view class="bk" wx:if="{{tab === 'all' || tab === 'free'}}"
          bindtap="openFnd" data-key="{{item.key}}">
      <view class="bk-top"><text>{{item.category}}</text><text class="acc-free">免费</text></view>
      <view class="bk-glyph">{{item.mark}}</view>
      <view class="bk-name">{{item.name}}</view>
      <view class="bk-sub">{{item.subtitle}}</view>
      <view class="bk-bottom"><text>{{item.time}}</text><b>开始修习 →</b></view>
    </view>
  </block>

  <!-- 秘籍 -->
  <block wx:for="{{secrets}}" wx:key="key">
    <view class="bk ink" wx:if="{{tab === 'all' || tab === item.cat}}"
          bindtap="openSec" data-key="{{item.key}}">
      <view class="bk-top">
        <text>{{item.catLabel}}</text>
        <text class="{{item.using ? 'acc-using' : 'acc-free'}}">{{item.using ? '使用中' : '免费开放'}}</text>
      </view>
      <view class="bk-glyph">{{item.glyph}}</view>
      <view class="bk-name">{{item.name}}</view>
      <view class="bk-sub">{{item.tagline}}</view>
      <view class="bk-bottom"><text>{{item.weeks}} 周</text><b>查看详情 →</b></view>
    </view>
  </block>

  <view class="card">
    <view class="h2">全部秘籍一览 <text class="mini">{{freeCount}} 本基础功法 + {{secCount}} 本进阶周期</text></view>
    <view class="muted" style="margin-top:8rpx">基础内容直接使用；应用一本秘籍前会先说明它将改动什么（目标 / 计划 / 挂哪些动作），随时能换回来。</view>
  </view>

  <!-- 还在补的：诚实卡 -->
  <view class="card" wx:if="{{road.length}}">
    <view class="h2">还在补的 <text class="mini">{{road.length}} 本</text></view>
    <view wx:for="{{road}}" wx:key="name" style="margin-top:10rpx">
      <view class="strong">{{item.name}}</view>
      <view class="muted">{{item.why}}</view>
    </view>
  </view>
</block>

<!-- ═══════════ 秘籍详情 ═══════════ -->
<block wx:if="{{view === 'sec'}}">
  <view class="text-link" bindtap="backList">‹ 返回藏经阁</view>
  <view class="card cover">
    <view class="h2">{{cur.name}} <text wx:if="{{cur.using}}" class="tag-gold">正在用</text> <text class="tag">{{cur.grade}}功法</text></view>
    <view class="muted">{{cur.weeks}} 周 · {{cur.tagline}}</view>
    <view class="muted" style="margin-top:6rpx">适合：{{cur.forWho}}</view>
  </view>

  <view class="card">
    <view class="h2">这本秘籍解决什么</view>
    <view class="li" wx:for="{{cur.solves}}" wx:key="*this"><view class="li-dot">·</view><text>{{item}}</text></view>
  </view>

  <view class="card" wx:if="{{cur.theory.length}}">
    <view class="h2">理论 · 底层逻辑</view>
    <view class="li-block" wx:for="{{cur.theory}}" wx:key="idx">
      <view class="strong" wx:if="{{item.t}}">{{item.t}}</view>
      <view class="muted">{{item.d}}</view>
      <view class="from" wx:if="{{item.from}}">出处：{{item.from}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{cur.eat.length}}">
    <view class="h2">怎么吃</view>
    <view class="li-block" wx:for="{{cur.eat}}" wx:key="idx">
      <view class="strong" wx:if="{{item.t}}">{{item.t}}</view>
      <view class="muted">{{item.d}}</view>
      <view class="from" wx:if="{{item.from}}">出处：{{item.from}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{cur.train.length}}">
    <view class="h2">怎么练</view>
    <view class="li-block" wx:for="{{cur.train}}" wx:key="idx">
      <view class="strong" wx:if="{{item.t}}">{{item.t}}</view>
      <view class="muted">{{item.d}}</view>
      <view class="from" wx:if="{{item.from}}">出处：{{item.from}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{cur.outline.length}}">
    <view class="h2">{{cur.weeks}} 周大纲</view>
    <view class="cyc" wx:for="{{cur.outline}}" wx:key="w">
      <view class="cyc-h">第 {{item.w}} 周</view>
      <view class="strong">{{item.t}}</view>
      <view class="muted">{{item.d}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{cur.sources.length}}">
    <view class="h2">内容出处</view>
    <view class="muted">这本秘籍整理自：</view>
    <view class="muted" wx:for="{{cur.sources}}" wx:key="*this">· {{item}}</view>
    <view class="muted" style="margin-top:10rpx">每一段内容下面都标了具体出处。我们只做整理和编排，不冒称是本人所讲。</view>
  </view>

  <view class="card">
    <view class="h2">{{cur.using ? '正在用这本' : '换上这本'}}</view>
    <view class="muted" wx:if="{{cur.append}}">点了会把 <text class="strong">{{cur.appendNames}}</text> 加到你每个训练日的末尾（计划页里能看到，随时可删）。你的分化、组次、周期都不动。</view>
    <view class="muted" wx:else>点了会改三样东西：<text class="strong">目标</text>（{{cur.presetGoal}}）、<text class="strong">训练计划</text>（{{cur.presetSplit}} / {{cur.presetFreq}}），并把周期起点重置到今天。饮食口径在饮食页自己挑。</view>
    <view class="btn block" wx:if="{{!cur.using}}" bindtap="useSecret" data-key="{{cur.key}}">
      {{cur.append ? '用这本 · 挂到我的训练日' : '用这本 · 换掉我的计划'}}
    </view>
    <view class="btn ghost block" bindtap="goToday">跟着开练 → 去今天的训练</view>
    <view class="btn ghost block" wx:if="{{cur.hasBackup}}" bindtap="restoreBackup">↩ 换回挂秘籍之前的计划</view>
  </view>
</block>

<!-- ═══════════ 功法详情 ═══════════ -->
<block wx:if="{{view === 'fnd'}}">
  <view class="text-link" bindtap="backList">‹ 返回藏经阁</view>
  <view class="fnd-intro">
    <view class="fnd-mark">{{cur.mark}}</view>
    <view class="fnd-name">{{cur.name}}</view>
    <view class="fnd-sub">{{cur.subtitle}}</view>
    <view class="muted">{{cur.who}} · {{cur.time}}</view>
  </view>
  <view class="card">
    <view class="muted">{{cur.intro}}</view>
  </view>

  <view class="card">
    <view class="h2">今天跟着做 <text class="mini">{{lessonProgress}}</text></view>
    <view class="lesson" wx:for="{{secRows}}" wx:key="idx">
      <checkbox checked="{{item.done}}" bindtap="toggleLesson" data-i="{{item.idx}}"/>
      <view class="lesson-txt">
        <view class="strong">{{item.title}}</view>
        <view class="muted">{{item.body}}</view>
      </view>
    </view>
    <view class="muted" style="margin-top:10rpx">勾选用于今天的学习与执行记录，不自动算作力量训练。</view>
  </view>

  <view class="card">
    <view class="h2">现在开始</view>
    <block wx:if="{{cur.actions.length}}">
      <view class="act" wx:for="{{cur.actions}}" wx:key="name"><text class="strong">{{item.name}}</text><text class="muted">{{item.sets}}</text></view>
      <view class="btn block" bindtap="startFnd">跟着开练 · 加进今天的训练</view>
    </block>
    <block wx:else>
      <view class="btn block" bindtap="goToday">去训练 · 打开热身与计时</view>
    </block>
  </view>

  <view class="card">
    <view class="h2">内容来源与适用范围</view>
    <view class="muted">{{cur.source}}</view>
  </view>
</block>
