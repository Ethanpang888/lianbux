/* pages/secret/secret.wxss —— 藏经阁 */

/* ── 列表头部 ── */
.lead { padding: 28rpx 24rpx 8rpx; }
.lead-eyebrow { color: var(--green); font-size: 22rpx; letter-spacing: 4rpx; }
.lead-title { font-size: 36rpx; font-weight: 700; margin: 8rpx 0; }

/* ── 分类 tabs ── */
.tabs { white-space: nowrap; padding: 12rpx 20rpx; }
.tab {
  display: inline-block; padding: 10rpx 26rpx; margin-right: 14rpx;
  background: var(--card); border: 1rpx solid var(--line); border-radius: 999rpx;
  font-size: 24rpx; color: var(--sub);
}
.tab.on { background: var(--green); color: #12291b; border-color: var(--green); font-weight: 600; }

/* ── 功法 / 秘籍卡 ── */
.bk {
  background: var(--card); border-radius: 20rpx; padding: 26rpx; margin: 16rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); border-left: 8rpx solid var(--green);
}
.bk.ink { border-left-color: var(--text); }
.bk-top { display: flex; justify-content: space-between; font-size: 22rpx; color: var(--sub); }
.acc-free { color: var(--green); font-weight: 600; }
.acc-paid { color: var(--warn); font-weight: 600; }
.acc-using { color: var(--green); font-weight: 700; }
.bk-glyph {
  width: 72rpx; height: 72rpx; border-radius: 16rpx; margin: 14rpx 0;
  background: var(--green-soft); color: var(--green-dark);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 700;
}
.bk.ink .bk-glyph { background: var(--bg); color: var(--text); }
.bk-name { font-size: 30rpx; font-weight: 700; }
.bk-sub { font-size: 24rpx; color: var(--sub); margin: 8rpx 0 14rpx; }
.bk-bottom { display: flex; justify-content: space-between; align-items: center; font-size: 22rpx; color: var(--sub); }
.bk-bottom b { color: var(--green); font-size: 24rpx; }

.h2 { font-size: 28rpx; font-weight: 700; margin-bottom: 12rpx; }
.mini { font-size: 22rpx; color: var(--sub); font-weight: 400; }
.strong { font-size: 26rpx; font-weight: 600; }
.tag-gold {
  font-size: 20rpx; color: var(--warn); background: var(--warn-soft);
  border-radius: 8rpx; padding: 4rpx 12rpx; vertical-align: middle;
}
.tag {
  font-size: 20rpx; color: var(--green-dark); background: var(--green-soft);
  border-radius: 8rpx; padding: 4rpx 12rpx; vertical-align: middle;
}
.text-link { color: var(--sub); font-size: 24rpx; padding: 20rpx 24rpx 0; }

/* ── 秘籍详情 ── */
.cover { border-top: 6rpx solid var(--green); }
.li { display: flex; margin-top: 10rpx; }
.li-dot { color: var(--green); font-weight: 700; margin-right: 10rpx; }
.li-block { margin-top: 14rpx; }
.from { font-size: 20rpx; color: var(--sub); margin-top: 4rpx; }
.cyc { border-left: 6rpx solid var(--green-soft); padding-left: 16rpx; margin-top: 14rpx; }
.cyc-h { color: var(--green); font-size: 22rpx; font-weight: 700; margin-bottom: 4rpx; }

/* ── 功法详情 ── */
.fnd-intro {
  margin: 16rpx 20rpx; padding: 30rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, var(--green-dark), var(--green)); color: #12291b;
}
.fnd-mark {
  width: 84rpx; height: 84rpx; border-radius: 18rpx; margin-bottom: 14rpx;
  background: rgba(255,255,255,0.16);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700;
}
.fnd-name { font-size: 34rpx; font-weight: 700; }
.fnd-sub { font-size: 24rpx; opacity: 0.85; margin: 6rpx 0 10rpx; }
.fnd-intro .muted { color: rgba(255,255,255,0.75); }

.lesson { display: flex; align-items: flex-start; margin-top: 16rpx; }
.lesson-txt { flex: 1; margin-left: 12rpx; }
.act {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 0; border-bottom: 1rpx solid var(--line);
}
