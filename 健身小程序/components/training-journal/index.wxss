.journal-input{padding:24rpx;border:1rpx solid var(--line);border-radius:20rpx;margin:20rpx 0}.journal-tags{display:flex;flex-wrap:wrap;gap:12rpx}.chip{padding:8rpx 18rpx;border-radius:40rpx;background:var(--bg);font-size:24rpx;color:var(--sub)}.chip.on{background:var(--green-soft);color:var(--green-dark)}.journal-text{width:100%;height:180rpx;box-sizing:border-box;border:1rpx solid var(--line);border-radius:20rpx;padding:24rpx;margin-top:24rpx;font-size:28rpx}.count{text-align:right}.journal-actions{display:flex;gap:16rpx}.journal-action{flex:1}.journal-photos{display:flex;gap:16rpx;flex-wrap:wrap}.photo{width:140rpx;font-size:22rpx;color:var(--sub)}.journal-photo{width:140rpx;height:160rpx;border-radius:16rpx}
