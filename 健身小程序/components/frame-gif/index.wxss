:host{display:block;width:100%}.fg{width:100%}.fg-stage{position:relative;width:100%;padding-top:66.67%;overflow:hidden;background:var(--bg);border-radius:12rpx}.fg-image,.fg-empty{position:absolute;left:0;top:0;width:100%;height:100%;box-sizing:border-box}.fg-image{opacity:0}.fg-image.pose-0,.fg-image.selected{opacity:1}.paused .fg-image{opacity:0}.paused .fg-image.selected{opacity:1}.fg-empty{display:flex;align-items:center;justify-content:center;color:var(--sub);font-size:22rpx;text-align:center;padding:12rpx;background:var(--bg)}.playing .pose-0{opacity:1}.playing .pose-1{animation:pose-swap var(--pose-duration,3000ms) steps(1,end) infinite}.fg-controls{display:flex;gap:12rpx;margin-top:8rpx}.fg-controls button{flex:1;font-size:24rpx;line-height:2.2;padding:0 12rpx;background:var(--green-soft);color:var(--text)}@keyframes pose-swap{0%{opacity:0}50%{opacity:1}100%{opacity:0}}
