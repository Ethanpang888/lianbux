<view class="fg">
 <view class="fg-stage {{paused?'paused':''}} {{ready && list.length>1 && !paused && mode!=='static'?'playing':''}}" style="--pose-duration:{{speed<1000?3000:speed*2}}ms">
  <image wx:for="{{list}}" wx:key="*this" src="{{item}}" mode="aspectFit" class="fg-image pose-{{index}} {{paused && current===index?'selected':''}}" data-i="{{index}}" bindload="onLoad" binderror="onErr"/>
  <view wx:if="{{err}}" class="fg-empty" catchtap="retry">图示加载失败 · 点此重试</view>
  <view wx:elif="{{!list.length}}" class="fg-empty">暂无图示</view>
 </view>
 <view wx:if="{{interactive && list.length>1 && !err}}" class="fg-controls"><button catchtap="toggle">{{paused?'播放动作':'暂停演示'}}</button><button catchtap="next">逐帧查看</button></view>
</view>
