.wrap { padding: 24rpx; }
.gifbox { background:var(--text); border-radius:16rpx; overflow:hidden; }
.ttl { font-size:38rpx; font-weight:700; margin:24rpx 4rpx 12rpx; color:var(--text); }
.row { display:flex; align-items:center; gap:16rpx; margin:8rpx 4rpx 24rpx; }
.badge { font-size:24rpx; padding:6rpx 18rpx; border-radius:30rpx; color:#fff; }
.badge.home { color: var(--button-text); background:var(--green); }
.badge.gym { background:#44534a; }
.meta { font-size:26rpx; color:var(--sub); }
.sec { background:var(--card); border-radius:16rpx; padding:24rpx; margin-bottom:24rpx; }
.h { font-size:28rpx; font-weight:700; color:var(--green); margin-bottom:12rpx; }
.po { font-size:28rpx; line-height:1.7; color:var(--text); white-space:pre-wrap; }
.tip { font-size:24rpx; color:var(--sub); text-align:center; margin-top:8rpx; }
.empty { text-align:center; color:var(--sub); margin-top:120rpx; font-size:28rpx; }
