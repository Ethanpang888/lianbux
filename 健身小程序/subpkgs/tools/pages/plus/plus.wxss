.page-heading{margin:24rpx 30rpx}.page-title{font-size:40rpx;font-weight:700}.chips{display:flex;gap:12rpx;flex-wrap:wrap;margin:20rpx 0}.chip{padding:12rpx 20rpx;border:1rpx solid var(--line);border-radius:30rpx;font-size:24rpx}.chip.on{color:var(--green-dark);background:var(--green-soft)}input,.picker{padding:22rpx;border:1rpx solid var(--line);border-radius:16rpx;margin:16rpx 0}rich-text{font-size:26rpx;line-height:1.8;overflow-wrap:anywhere}button{margin-top:16rpx}.row{gap:14rpx}.pay-qr{display:block;width:320rpx;height:320rpx;margin:24rpx auto}