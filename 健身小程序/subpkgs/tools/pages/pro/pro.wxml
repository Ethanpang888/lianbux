<page-meta page-style="{{themeStyle}}"/><view wx:if="{{loading}}" class="card">正在同步权益与训练记录…</view><view wx:elif="{{error}}" class="card"><view>{{error}}</view><button bindtap="load">重新加载</button><button data-url="/pages/profile/profile" bindtap="go">我的档案</button></view><block wx:else><view wx:if="{{!owned}}" class="card"><view class="title">选择开通档位</view><view class="chips"><text wx:for="{{tiers}}" wx:key="k" class="chip {{payTier===item.k?'on':''}}" data-k="payTier" data-v="{{item.k}}" bindtap="choose">{{item.label}} ¥{{item.price}}</text></view></view><view class="card"><rich-text nodes="{{body}}"/></view><view wx:if="{{!owned}}" class="card"><view class="title">{{payment}}</view><view class="muted">付款备注你的注册邮箱或用户名，付款截图发给阿清获取开通码；权益由服务端核销。</view><image class="pay-qr" src="https://c289b837374c4dfc8f14d386d2e36a02.app.workbuddy.host/assets/pay-qr.png" mode="aspectFit" bindtap="previewQr" show-menu-by-longpress/><input placeholder="输入开通码" value="{{code}}" data-k="code" bindinput="field"/><button class="btn" loading="{{busy}}" disabled="{{busy}}" bindtap="redeem">兑换并解锁</button></view><view wx:if="{{owned}}" class="card"><button class="btn ghost" bindtap="cancel">取消会员权益（立即失效）</button></view><view class="card"><view class="title">相关工具</view><button class="btn ghost" data-url="/pages/today/today" bindtap="go">今日训练</button><button class="btn ghost" data-url="/pages/diet/diet" bindtap="go">今日饮食</button><button class="btn ghost" data-url="/pages/ai/ai" bindtap="go">随身导师 · 免费可用</button><button class="btn ghost" data-url="/subpkgs/tools/pages/plus/plus" bindtap="go">进阶工具包</button><button class="btn ghost" data-url="/subpkgs/tools/pages/plan12/plan12" bindtap="go">十二周计划</button></view></block>